    function initSentientBuildingCanvas() {
      const canvas = document.getElementById('sentientBuildingCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let w = canvas.width = canvas.parentElement.clientWidth;
      let h = canvas.height = canvas.parentElement.clientHeight;
      let offset = 0;

      function draw() {
        ctx.fillStyle = 'rgba(2, 6, 23, 0.3)';
        ctx.fillRect(0, 0, w, h);
        offset += 0.5;
        ctx.strokeStyle = '#10b981';
        ctx.lineWidth = 2;
        ctx.strokeRect(w / 2 - 120, h / 2 - 140, 240, 280);
        ctx.fillStyle = 'rgba(16, 185, 129, 0.15)';
        ctx.fillRect(w / 2 - 120, h / 2 - 140, 240, 280);
        
        ctx.fillStyle = '#34d399';
        for (let r = 0; r < 6; r++) {
          for (let c = 0; c < 4; c++) {
            if ((Math.floor(offset / 30) + r + c) % 2 === 0) {
              ctx.fillRect(w / 2 - 90 + c * 50, h / 2 - 110 + r * 40, 30, 25);
            }
          }
        }
        requestAnimationFrame(draw);
      }
      draw();
    }

