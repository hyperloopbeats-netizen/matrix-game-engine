            resolve(request.result);
          };
          request.onerror = () => reject(request.error);
        });
      },
      async similaritySearch(query, limit = 3) {
        if (!this.db) await this.init();
        const queryVector = this.simulateEmbedding(query);
        return new Promise((resolve, reject) => {
          const transaction = this.db.transaction([this.storeName], 'readonly');
          const store = transaction.objectStore(this.storeName);
          const request = store.getAll();
          request.onsuccess = () => {
            const docs = request.result;
            const scored = docs.map(doc => ({ ...doc, score: this.cosineSimilarity(queryVector, doc.vector) }));
            scored.sort((a, b) => b.score - a.score);
            const results = scored.slice(0, limit);
            AIM_BRAIN.publish('VECTOR', 'RAG_QUERY', `Retrieved ${results.length} relevant context chunks.`);
            resolve(results);
          };
          request.onerror = () => reject(request.error);
        });
      },
      simulateEmbedding(text) {
        const vector = new Array(32).fill(0);
        for (let i = 0; i < text.length; i++) {
          const charCode = text.charCodeAt(i);
          vector[charCode % 32] += Math.sin(charCode);
        }
        const magnitude = Math.sqrt(vector.reduce((sum, val) => sum + val * val, 0)) || 1;
        return vector.map(val => val / magnitude);
      },
      cosineSimilarity(vecA, vecB) {
        let dotProduct = 0;
        for (let i = 0; i < vecA.length; i++) dotProduct += vecA[i] * vecB[i];
        return dotProduct;
      }
    };

