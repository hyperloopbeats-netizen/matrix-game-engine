    // Canvas Renderers
    function initGenerativeMatrixCanvas() {
      const canvas = document.getElementById('generativeMatrixCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let w = canvas.width = canvas.parentElement.clientWidth;
      let h = canvas.height = canvas.parentElement.clientHeight;
      let nodes = Array.from({length: 25}, () => ({
        x: Math.random() * w, y: Math.random() * h,
        vx: (Math.random() - 0.5) * 1.5, vy: (Math.random() - 0.5) * 1.5,
        radius: Math.random() * 4 + 3
      }));

      function draw() {
        ctx.fillStyle = 'rgba(2, 6, 23, 0.25)';
        ctx.fillRect(0, 0, w, h);
        nodes.forEach((n, i) => {
          n.x += n.vx; n.y += n.vy;
          if (n.x < 0 || n.x > w) n.vx *= -1;
          if (n.y < 0 || n.y > h) n.vy *= -1;
          ctx.fillStyle = '#38bdf8';
          ctx.beginPath(); ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2); ctx.fill();
          for (let j = i + 1; j < nodes.length; j++) {
            let m = nodes[j];
            let dist = Math.hypot(n.x - m.x, n.y - m.y);
            if (dist < 120) {
              ctx.strokeStyle = `rgba(56, 189, 248, ${1 - dist / 120})`;
              ctx.lineWidth = 1;
              ctx.beginPath(); ctx.moveTo(n.x, n.y); ctx.lineTo(m.x, m.y); ctx.stroke();
            }
          }
        });
        requestAnimationFrame(draw);
      }
      draw();
    }

