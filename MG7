    function initLiquidBrainCanvas() {
      const canvas = document.getElementById('liquidBrainCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let w = canvas.width = canvas.parentElement.clientWidth;
      let h = canvas.height = canvas.parentElement.clientHeight;
      let t = 0;

      function draw() {
        ctx.fillStyle = 'rgba(2, 6, 23, 0.25)';
        ctx.fillRect(0, 0, w, h);
        t += 0.03;
        ctx.strokeStyle = '#ec4899';
        ctx.lineWidth = 3;
        ctx.beginPath();
        for (let x = 0; x < w; x += 5) {
          let y = h / 2 + Math.sin(x * 0.015 + t) * 40 + Math.cos(x * 0.03 - t * 1.5) * 20;
          if (x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.stroke();
        requestAnimationFrame(draw);
      }
      draw();
    }

