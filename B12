<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>B12 Matrix OS: Master Video Engine (Playable Suite)</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background-color: #030712; color: #38bdf8; font-family: monospace; }
    .glow { text-shadow: 0 0 12px rgba(56,189,248,0.7); }
    .panel { background: rgba(8, 14, 28, 0.95); border: 1px solid rgba(56, 189, 248, 0.4); backdrop-filter: blur(12px); box-shadow: 0 0 25px rgba(56,189,248,0.08); }
    canvas { image-rendering: pixelated; image-rendering: crisp-edges; }
    input[type=range] { accent-color: #38bdf8; }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-between p-4 md:p-6">

  <!-- Header -->
  <header class="w-full max-w-5xl flex justify-between items-center border-b border-sky-500/30 pb-4 mb-4">
    <div>
      <h1 class="text-2xl font-black tracking-widest text-sky-400 glow">B12 MATRIX VIDEO ENGINE</h1>
      <p class="text-xs text-sky-600">MASTER PLAYABLE SUITE // FIXED PIPELINE</p>
    </div>
    <div id="statusBadge" class="px-3 py-1 text-xs rounded bg-sky-950 text-sky-400 border border-sky-500/50 shadow-[0_0_10px_rgba(56,189,248,0.3)]">
      SYSTEM: ACTIVE // READY
    </div>
  </header>

  <!-- Main Workspace -->
  <main class="w-full max-w-5xl grid grid-cols-1 md:grid-cols-3 gap-6">
    
    <!-- Video Viewport & Playback Deck -->
    <div class="md:col-span-2 panel p-5 rounded-2xl flex flex-col items-center justify-center relative">
      <div class="absolute top-3 left-4 text-[11px] text-sky-400/85 tracking-wider font-bold flex items-center gap-2">
        <span id="recordIndicator" class="w-2 h-2 rounded-full bg-sky-400 animate-pulse shadow-[0_0_8px_#38bdf8]"></span>
        MASTER SHADER VIEWPORT
      </div>
      
      <!-- Canvas Container -->
      <div class="mt-6 p-2 rounded-xl bg-black/80 border border-sky-500/40 shadow-[0_0_35px_rgba(56,189,248,0.2)]">
        <canvas id="videoCanvas" width="160" height="120" class="w-[320px] h-[240px] md:w-[440px] md:h-[330px] rounded cursor-crosshair"></canvas>
      </div>

      <video id="sourceVideo" class="hidden" playsinline muted crossorigin="anonymous"></video>

      <!-- Timeline Scrubbing Bar -->
      <div class="w-full mt-4 px-2">
        <div class="flex justify-between text-[10px] text-sky-600 mb-1 font-bold">
          <span id="currentTimeLabel">00:00</span>
          <span id="durationLabel">SYNTHETIC (00:00)</span>
        </div>
        <input type="range" id="timelineSlider" min="0" max="100" value="0" step="0.1" class="w-full bg-sky-950 border border-sky-500/40 rounded h-1.5 cursor-pointer">
      </div>

      <!-- Playback Controls -->
      <div class="flex flex-wrap gap-2 mt-3 w-full justify-center">
        <button id="playPauseBtn" class="px-3 py-1.5 bg-sky-500 hover:bg-sky-400 text-black font-extrabold text-[10px] rounded transition shadow-[0_0_10px_rgba(56,189,248,0.4)]">PLAY / PAUSE</button>
        <button id="stepBackBtn" class="px-3 py-1.5 panel text-sky-400 hover:bg-sky-950 text-[10px] rounded border border-sky-500/50">-5s</button>
        <button id="stepForwardBtn" class="px-3 py-1.5 panel text-sky-400 hover:bg-sky-950 text-[10px] rounded border border-sky-500/50">+5s</button>
        <button id="recordBtn" class="px-3 py-1.5 bg-sky-950 hover:bg-sky-900 text-sky-300 font-extrabold text-[10px] rounded border border-sky-500/80 shadow-[0_0_12px_rgba(56,189,248,0.3)]">🔴 RECORD</button>
      </div>

      <!-- Source & Filter Switching -->
      <div class="flex flex-wrap gap-2 mt-3 w-full justify-center border-t border-sky-500/20 pt-3">
        <button id="webcamBtn" class="px-2.5 py-1 panel text-sky-400 text-[10px] rounded hover:bg-sky-950">Webcam</button>
        <label class="px-2.5 py-1 panel hover:bg-sky-950 text-sky-400 font-bold text-[10px] rounded border border-sky-500/50 cursor-pointer">
          Upload MP4 <input type="file" id="videoUpload" accept="video/mp4,video/webm,video/*" class="hidden">
        </label>
        <button id="syntheticBtn" class="px-2.5 py-1 bg-sky-950 text-sky-300 border border-sky-500/40 text-[10px] rounded">Synthetic</button>
        <button onclick="setFilter('crt')" class="filter-btn px-2.5 py-1 bg-sky-950 text-sky-300 border border-sky-500/40 text-[10px] rounded">CRT</button>
        <button onclick="setFilter('edge')" class="filter-btn px-2.5 py-1 panel text-sky-400 text-[10px] rounded">Edge</button>
        <button onclick="setFilter('glow')" class="filter-btn px-2.5 py-1 panel text-sky-400 text-[10px] rounded">Glow</button>
      </div>
    </div>

    <!-- Telemetry Deck -->
    <div class="panel p-5 rounded-2xl flex flex-col justify-between">
      <div>
        <h2 class="text-xs font-extrabold tracking-widest text-sky-300 border-b border-sky-500/30 pb-2 mb-4">DSP & TELEMETRY DECK</h2>
        <div class="space-y-4 text-xs">
          <div>
            <div class="text-sky-600 font-bold">SOURCE MODE</div>
            <div id="metricSource" class="text-sm font-black text-sky-400 glow">Synthetic Grid</div>
          </div>
          <div>
            <div class="text-sky-600 font-bold">PLAYBACK STATE</div>
            <div id="metricState" class="text-lg font-black text-sky-300">PLAYING</div>
          </div>
          <div>
            <div class="text-sky-600 font-bold">RENDER FPS</div>
            <div id="metricFps" class="text-xl font-black text-sky-300">60 FPS</div>
          </div>
          
          <!-- Audio Spectrum Visualizer Canvas -->
          <div>
            <div class="text-sky-600 font-bold mb-1 flex justify-between">
              <span>AUDIO SPECTRUM (FFT)</span>
              <span id="audioPeak" class="text-sky-400">0 Hz</span>
            </div>
            <div class="p-1 rounded bg-black/90 border border-sky-500/40">
              <canvas id="audioCanvas" width="220" height="70" class="w-full h-[60px] rounded"></canvas>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-4 pt-4 border-t border-sky-500/30 text-[10px] text-sky-600 leading-relaxed">
        B12 MATRIX OS ENGINE ONLINE.
      </div>
    </div>

  </main>

  <footer class="text-center text-[10px] text-sky-700 mt-6 tracking-widest">
    B12 MATRIX VIDEO ENGINE ARCHITECTURE // ALL RIGHTS RESERVED
  </footer>

  <script>
    const canvas = document.getElementById('videoCanvas');
    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    
    const audioCanvas = document.getElementById('audioCanvas');
    const actx = audioCanvas.getContext('2d');

    const video = document.getElementById('sourceVideo');

    const internalWidth = 160;
    const internalHeight = 120;
    canvas.width = internalWidth;
    canvas.height = internalHeight;

    let sourceType = 'synthetic';
    let currentFilter = 'crt';
    let isPlaying = true;
    let isScrubbing = false;
    let isMouseDown = false;
    let mouseX = -1000, mouseY = -1000;
    let frameCount = 0, lastTime = performance.now(), fps = 60;

    let audioCtx = null;
    let analyser = null;
    let audioSourceNode = null;
    let destinationNode = null;
    let frequencyData = new Uint8Array(64);

    let mediaRecorder = null;
    let recordedChunks = [];
    let isRecording = false;

    function initAudioContext(mediaElement) {
      try {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          analyser = audioCtx.createAnalyser();
          analyser.fftSize = 128;
          frequencyData = new Uint8Array(analyser.frequencyBinCount);
          destinationNode = audioCtx.createMediaStreamDestination();
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        if (audioSourceNode) {
          try { audioSourceNode.disconnect(); } catch (e) {}
        }
        audioSourceNode = audioCtx.createMediaElementSource(mediaElement);
        audioSourceNode.connect(analyser);
        analyser.connect(audioCtx.destination);
        analyser.connect(destinationNode);
      } catch (e) {
        console.log('Audio Context initialization note:', e);
      }
    }

    const offCanvas = document.createElement('canvas');
    offCanvas.width = internalWidth;
    offCanvas.height = internalHeight;
    const offCtx = offCanvas.getContext('2d', { willReadFrequently: true });

    function setFilter(type) {
      currentFilter = type;
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('bg-sky-950', 'border-sky-500');
        b.classList.add('panel');
      });
      event.target.classList.remove('panel');
      event.target.classList.add('bg-sky-950', 'border-sky-500');
    }

    const playPauseBtn = document.getElementById('playPauseBtn');
    playPauseBtn.addEventListener('click', () => {
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();

      if (sourceType === 'synthetic') {
        isPlaying = !isPlaying;
      } else {
        if (video.paused) {
          video.play().then(() => {
            isPlaying = true;
            document.getElementById('metricState').innerText = 'PLAYING';
          }).catch(err => console.log('Playback error:', err));
        } else {
          video.pause();
          isPlaying = false;
          document.getElementById('metricState').innerText = 'PAUSED';
        }
      }
      playPauseBtn.innerText = isPlaying ? 'PAUSE' : 'PLAY';
    });

    document.getElementById('stepBackBtn').addEventListener('click', () => {
      if (sourceType !== 'synthetic') video.currentTime = Math.max(0, video.currentTime - 5);
    });
    document.getElementById('stepForwardBtn').addEventListener('click', () => {
      if (sourceType !== 'synthetic') video.currentTime = Math.min(video.duration, video.currentTime + 5);
    });

    const timelineSlider = document.getElementById('timelineSlider');
    timelineSlider.addEventListener('mousedown', () => { isScrubbing = true; });
    timelineSlider.addEventListener('mouseup', () => { isScrubbing = false; });
    timelineSlider.addEventListener('input', (e) => {
      if (sourceType !== 'synthetic' && video.duration) {
        video.currentTime = (e.target.value / 100) * video.duration;
      }
    });

    document.getElementById('webcamBtn').addEventListener('click', async () => {
      try {
        if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
        const stream = await navigator.mediaDevices.getUserMedia({ video: { width: 320, height: 240 }, audio: true });
        video.srcObject = stream; 
        video.muted = false;
        await video.play();
        initAudioContext(video);
        sourceType = 'webcam'; 
        isPlaying = true;
        document.getElementById('metricSource').innerText = 'Live Camera+Mic';
        document.getElementById('durationLabel').innerText = 'LIVE STREAM';
        document.getElementById('statusBadge').innerText = 'STATUS: WEBCAM ACTIVE';
      } catch (e) { alert('Webcam/Mic access denied or unavailable.'); }
    });

    document.getElementById('videoUpload').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
        if (video.srcObject) {
          video.srcObject.getTracks().forEach(t => t.stop());
          video.srcObject = null;
        }
        const fileURL = URL.createObjectURL(file);
        video.src = fileURL;
        video.muted = false;
        video.loop = true;
        
        video.play().then(() => {
          initAudioContext(video);
          sourceType = 'file';
          isPlaying = true;
          document.getElementById('metricSource').innerText = file.name;
          document.getElementById('statusBadge').innerText = 'STATUS: FILE LOADED';
        }).catch(err => {
          alert('Error playing video file. Ensure it is a standard MP4 format.');
        });
      }
    });

    document.getElementById('syntheticBtn').addEventListener('click', () => {
      if (video.srcObject) { video.srcObject.getTracks().forEach(t => t.stop()); video.srcObject = null; }
      video.src = ''; 
      sourceType = 'synthetic'; 
      isPlaying = true;
      document.getElementById('metricSource').innerText = 'Synthetic Grid';
      document.getElementById('durationLabel').innerText = 'SYNTHETIC';
      document.getElementById('statusBadge').innerText = 'STATUS: SYNTHETIC ACTIVE';
    });

    const recordBtn = document.getElementById('recordBtn');
    recordBtn.addEventListener('click', () => {
      if (!isRecording) {
        recordedChunks = [];
        const canvasStream = canvas.captureStream(60);
        let combinedStream = canvasStream;
        if (destinationNode && destinationNode.stream && sourceType !== 'synthetic') {
          const audioTrack = destinationNode.stream.getAudioTracks()[0];
          if (audioTrack) combinedStream.addTrack(audioTrack);
        }
        try {
          mediaRecorder = new MediaRecorder(combinedStream, { mimeType: 'video/webm;codecs=vp9' });
        } catch (e) {
          mediaRecorder = new MediaRecorder(combinedStream, { mimeType: 'video/webm' });
        }
        mediaRecorder.ondataavailable = e => { if (e.data && e.data.size > 0) recordedChunks.push(e.data); };
        mediaRecorder.onstop = () => {
          const blob = new Blob(recordedChunks, { type: 'video/webm' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url; a.download = `b12-matrix-recording-${Date.now()}.webm`;
          document.body.appendChild(a); a.click();
          setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(url); }, 100);
        };
        mediaRecorder.start();
        isRecording = true;
        recordBtn.innerText = '⏹ STOP & EXPORT';
        recordBtn.classList.remove('bg-sky-950');
        recordBtn.classList.add('bg-red-950', 'text-red-400', 'border-red-500');
      } else {
        mediaRecorder.stop();
        isRecording = false;
        recordBtn.innerText = '🔴 RECORD';
        recordBtn.classList.remove('bg-red-950', 'text-red-400', 'border-red-500');
        recordBtn.classList.add('bg-sky-950');
      }
    });

    canvas.addEventListener('mousedown', (e) => { isMouseDown = true; updateMouse(e); });
    window.addEventListener('mouseup', () => { isMouseDown = false; mouseX = -1000; mouseY = -1000; });
    canvas.addEventListener('mousemove', (e) => { if (isMouseDown) updateMouse(e); });

    function updateMouse(e) {
      const rect = canvas.getBoundingClientRect();
      mouseX = Math.floor(((e.clientX - rect.left) / rect.width) * internalWidth);
      mouseY = Math.floor(((e.clientY - rect.top) / rect.height) * internalHeight);
    }

    function formatTime(sec) {
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
    }

    function renderPipeline(timestamp) {
      frameCount++;
      if (timestamp - lastTime >= 1000) {
        fps = frameCount; frameCount = 0; lastTime = timestamp;
        document.getElementById('metricFps').innerText = fps + ' FPS';
      }

      if (isPlaying) {
        if ((sourceType === 'webcam' || sourceType === 'file') && video.readyState >= video.HAVE_CURRENT_DATA) {
          offCtx.drawImage(video, 0, 0, internalWidth, internalHeight);
          if (sourceType === 'file' && !isScrubbing && video.duration) {
            timelineSlider.value = (video.currentTime / video.duration) * 100;
            document.getElementById('currentTimeLabel').innerText = formatTime(video.currentTime);
            document.getElementById('durationLabel').innerText = formatTime(video.duration);
          }
        } else if (sourceType === 'synthetic') {
          const t = timestamp * 0.002;
          const imgData = offCtx.createImageData(internalWidth, internalHeight);
          for (let y = 0; y < internalHeight; y++) {
            for (let x = 0; x < internalWidth; x++) {
              const i = (y * internalWidth + x) * 4;
              const val = Math.sin(x * 0.1 + t) * Math.cos(y * 0.1 - t) * 128 + 128;
              imgData.data[i] = val * 0.2; imgData.data[i+1] = val * 0.8; imgData.data[i+2] = val; imgData.data[i+3] = 255;
            }
          }
          offCtx.putImageData(imgData, 0, 0);
          document.getElementById('currentTimeLabel').innerText = formatTime(timestamp * 0.001);
        }
      }

      actx.fillStyle = 'rgba(3, 7, 18, 0.9)';
      actx.fillRect(0, 0, audioCanvas.width, audioCanvas.height);

      if (analyser && sourceType !== 'synthetic') {
        analyser.getByteFrequencyData(frequencyData);
        const barWidth = audioCanvas.width / frequencyData.length;
        let maxVal = 0, peakIdx = 0;

        for (let i = 0; i < frequencyData.length; i++) {
          const val = frequencyData[i];
          if (val > maxVal) { maxVal = val; peakIdx = i; }
          const barHeight = (val / 255) * audioCanvas.height;

          actx.fillStyle = '#38bdf8';
          actx.fillRect(i * barWidth, audioCanvas.height - barHeight, barWidth - 1, barHeight);
        }
        document.getElementById('audioPeak').innerText = (peakIdx * 172).toFixed(0) + ' Hz';
      } else {
        const barWidth = audioCanvas.width / 16;
        for (let i = 0; i < 16; i++) {
          const h = (Math.sin(timestamp * 0.005 + i) * 0.5 + 0.5) * audioCanvas.height * 0.7;
          actx.fillStyle = 'rgba(56, 189, 248, 0.4)';
          actx.fillRect(i * barWidth + 2, audioCanvas.height - h, barWidth - 3, h);
        }
        document.getElementById('audioPeak').innerText = '0 Hz (SYNTH)';
      }

      const srcData = offCtx.getImageData(0, 0, internalWidth, internalHeight);
      const srcPixels = srcData.data;
      const outData = ctx.createImageData(internalWidth, internalHeight);
      const outPixels = outData.data;

      const w = internalWidth, h = internalHeight;

      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const idx = (y * w + x) * 4;
          const dist = Math.hypot(x - mouseX, y - mouseY);
          const isMasked = dist < 22;

          let r = srcPixels[idx], g = srcPixels[idx+1], b = srcPixels[idx+2];

          if (currentFilter === 'edge') {
            let gxR = 0, gyR = 0;
            if (x > 0 && x < w - 1 && y > 0 && y < h - 1) {
              const p = (ox, oy) => srcPixels[((y + oy) * w + (x + ox)) * 4];
              gxR = -p(-1,-1) + p(1,-1) - 2*p(-1,0) + 2*p(1,0) - p(-1,1) + p(1,1);
              gyR = -p(-1,-1) - 2*p(0,-1) - p(1,-1) + p(-1,1) + 2*p(0,1) + p(1,1);
            }
            const edge = Math.min(255, Math.hypot(gxR, gyR));
            r = isMasked ? 255 : 0;
            g = isMasked ? 0 : Math.floor(edge * 1.5);
            b = isMasked ? 255 : Math.floor(edge * 2);
          } else if (currentFilter === 'glow') {
            let lum = (r + g + b) / 3;
            lum = lum > 100 ? 255 : lum * 1.8;
            r = isMasked ? 255 : Math.floor(lum * 0.1);
            g = isMasked ? 255 : Math.floor(lum * 0.9);
            b = isMasked ? 0   : 255;
          } else {
            let lum = (r + g + b) / 3;
            r = Math.floor(lum * 0.2);
            g = Math.floor(lum * 0.7 + 30);
            b = Math.min(255, Math.floor(lum + 90));
            if (y % 2 === 0) { r *= 0.7; g *= 0.7; b *= 0.7; }
            if (isMasked) { r = 255 - r; g = 255; b = 255; }
          }

          outPixels[idx]     = r;
          outPixels[idx + 1] = g;
          outPixels[idx + 2] = b;
          outPixels[idx + 3] = 255;
        }
      }

      ctx.putImageData(outData, 0, 0);
      requestAnimationFrame(renderPipeline);
    }

    requestAnimationFrame(renderPipeline);
  </script>
</body>
</html>
