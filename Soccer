      if (!canvas) return;
      const container = canvas.parentElement;
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
      renderer.setSize(container.clientWidth, container.clientHeight);

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x020617);
      scene.fog = new THREE.FogExp2(0x020617, 0.018);

      const camera = new THREE.PerspectiveCamera(50, container.clientWidth / container.clientHeight, 0.1, 1000);
      scene.add(new THREE.AmbientLight(0xd9f6ff, 0.8));
      const sun = new THREE.DirectionalLight(0x00f3ff, 1.2);
      sun.position.set(20, 40, 20);
      scene.add(sun);

      const water = new THREE.Mesh(new THREE.PlaneGeometry(250, 250, 32, 32), new THREE.MeshStandardMaterial({ color: 0x041525, roughness: 0.1, metalness: 0.8 }));
      water.rotation.x = -Math.PI / 2;
      scene.add(water);

      const rig = new DragonflyRig(scene);
      const controller = new DragonflyFlightController(rig);

      window.addEventListener('keydown', e => {
        if (e.key === 'w' || e.key === 'ArrowUp') controller.controls.throttle = Math.min(1.0, controller.controls.throttle + 0.15);
        if (e.key === 's' || e.key === 'ArrowDown') controller.controls.throttle = Math.max(0.1, controller.controls.throttle - 0.15);
        if (e.key === 'a' || e.key === 'ArrowLeft') controller.controls.yawInput = 1.4;
        if (e.key === 'd' || e.key === 'ArrowRight') controller.controls.yawInput = -1.4;
      });

      const clock = new THREE.Clock();
      (function animateSim() {
        requestAnimationFrame(animateSim);
        const delta = Math.min(clock.getDelta(), 0.1);
        controller.update(delta);
        const targetCamPos = controller.position.clone().sub(new THREE.Vector3(0, 0, 10).applyAxisAngle(new THREE.Vector3(0,1,0), controller.heading)).add(new THREE.Vector3(0, 3, 0));
        camera.position.lerp(targetCamPos, 0.1);
        camera.lookAt(controller.position.clone().add(new THREE.Vector3(0, 1, 0)));
        renderer.render(scene, camera);
      })();
    }

    // --- Master Initialization ---
    window.addEventListener('DOMContentLoaded', () => {
      renderDock();
      renderSystemMenu();
      renderDesktopIcons();
      initWallpaperShader();
      setTimeout(() => openApp('agisynth'), 300);
      setTimeout(() => openApp('sovereign_eq'), 600);
    });
  </script>
</body>
</html>
