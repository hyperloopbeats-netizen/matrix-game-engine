    async function startVideoSynthesis() {
      if (!sourceImage && !sourceImageBase64) { switchAGITab('source'); return; }
      const totalFrames = 100;
      generatedFrames = [];
      const synthCanvas = document.createElement('canvas');
      synthCanvas.width = 320; synthCanvas.height = 320;
      const ctx = synthCanvas.getContext('2d');
      const baseImg = sourceImage || await new Promise(r => { const i = new Image(); i.onload = () => r(i); i.src = sourceImageBase64; });

      for (let f = 0; f < totalFrames; f++) {
        ctx.clearRect(0, 0, 320, 320);
        ctx.drawImage(baseImg, 0, 0, 320, 320);
        generatedFrames.push(synthCanvas.toDataURL('image/jpeg', 0.85));
        await new Promise(r => setTimeout(r, 5));
      }
      switchAGITab('player');
      initVideoPlayer();
