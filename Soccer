    function renderClipFrame(index) {
      if (generatedFrames.length === 0) return;
      currentFrameIndex = Math.max(0, Math.min(index, generatedFrames.length - 1));
      const canvas = document.getElementById('clipCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const img = new Image();
      img.onload = () => { ctx.clearRect(0, 0, 320, 320); ctx.drawImage(img, 0, 0); };
      img.src = generatedFrames[currentFrameIndex];
    }

    function toggleVideoPlayback() {
      if (generatedFrames.length === 0) return;
      isPlayingClip = !isPlayingClip;
      if (clipPlayInterval) { clearInterval(clipPlayInterval); clipPlayInterval = null; }
      if (isPlayingClip) {
        clipPlayInterval = setInterval(() => {
          currentFrameIndex++;
          if (currentFrameIndex >= generatedFrames.length) currentFrameIndex = 0;
          renderClipFrame(currentFrameIndex);
