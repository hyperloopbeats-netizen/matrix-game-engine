<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AiM OS - Enhanced Glassmorphic Workspace</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        aim: {
                            cyan: '#06b6d4',
                            magenta: '#ec4899',
                            dark: '#030712',
                            card: '#0f172a',
                            border: '#1e293b'
                        }
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            user-select: none;
            overflow: hidden;
        }
        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }
        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.4);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(6, 182, 212, 0.4);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(6, 182, 212, 0.7);
        }
        /* Glassmorphism Classes */
        .glass {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glass-panel {
            background: rgba(3, 7, 18, 0.65);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .glass-dock {
            background: rgba(11, 19, 38, 0.8);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .glow-cyan {
            box-shadow: 0 0 25px -5px rgba(6, 182, 212, 0.35);
        }
        .glow-magenta {
            box-shadow: 0 0 25px -5px rgba(236, 72, 153, 0.35);
        }
        /* Window Animation */
        @keyframes windowOpen {
            from { opacity: 0; transform: scale(0.95) translateY(10px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }
        .animate-window {
            animation: windowOpen 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        /* Dynamic Wallpapers */
        .bg-wallpaper-cyber {
            background: radial-gradient(circle at 50% 30%, #1e1b4b 0%, #030712 70%),
                        linear-gradient(to right, rgba(6, 182, 212, 0.1) 1px, transparent 1px),
                        linear-gradient(to bottom, rgba(236, 72, 153, 0.1) 1px, transparent 1px);
            background-size: 100% 100%, 40px 40px, 40px 40px;
        }
        .bg-wallpaper-cosmos {
            background: radial-gradient(circle at 20% 20%, #31103f 0%, #030712 80%),
                        radial-gradient(circle at 80% 80%, #0f172a 0%, #020617 70%);
        }

        /* FEATURE 3: Synthetic CRT Screen Overlay */
        .crt-overlay {
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.3) 50%), 
                        linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
            background-size: 100% 3px, 4px 100%;
            pointer-events: none;
            position: fixed;
            inset: 0;
            z-index: 999;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .crt-active .crt-overlay {
            opacity: 1;
        }
        .crt-active {
            filter: contrast(1.2) brightness(1.05) saturate(1.1);
        }
        @keyframes crtFlicker {
            0% { opacity: 0.97; }
            50% { opacity: 1; }
            100% { opacity: 0.98; }
        }
        .crt-active #desktop-bg {
            animation: crtFlicker 0.15s infinite;
        }
    </style>
</head>
<body id="desktop-bg" class="bg-wallpaper-cyber text-slate-100 h-screen w-screen relative overflow-hidden flex flex-col justify-between">

    <!-- FEATURE 3: Synthetic CRT Screen Overlay Element -->
    <div class="crt-overlay"></div>

    <!-- TOP TASKBAR -->
    <header class="h-9 glass border-b border-slate-800/80 flex items-center justify-between px-4 z-50 text-xs select-none">
        <div class="flex items-center space-x-3">
            <button onclick="toggleStartMenu()" class="flex items-center space-x-1.5 px-2 py-1 rounded hover:bg-white/10 transition text-cyan-400 font-semibold">
                <i data-lucide="cpu" class="w-4 h-4 text-cyan-400"></i>
                <span class="tracking-wider">AiM OS</span>
            </button>
            <div class="h-4 w-[1px] bg-slate-700/60"></div>
            <span id="active-app-title" class="text-slate-300 font-medium hidden sm:inline">Desktop</span>
        </div>

        <div class="flex items-center space-x-3">
            <!-- Quick Toggles -->
            <div class="hidden md:flex items-center space-x-2 bg-slate-900/50 px-2.5 py-1 rounded-full border border-slate-800">
                <button onclick="toggleAudioGlobal()" id="audio-toggle-btn" class="flex items-center space-x-1 text-slate-400 hover:text-cyan-400 transition" title="Global Audio">
                    <i data-lucide="volume-2" class="w-3.5 h-3.5"></i>
                    <span class="text-[11px]">Audio Active</span>
                </button>
                <span class="text-slate-700">|</span>
                <button onclick="toggleCRTMode()" id="crt-toggle-btn" class="flex items-center space-x-1 text-slate-400 hover:text-pink-400 transition" title="Toggle Synthetic CRT">
                    <i data-lucide="monitor" class="w-3.5 h-3.5"></i>
                    <span class="text-[11px]">CRT Screen</span>
                </button>
            </div>

            <!-- Notifications Bell -->
            <button onclick="toggleNotifications()" class="relative p-1.5 rounded hover:bg-white/10 transition text-slate-300">
                <i data-lucide="bell" class="w-4 h-4"></i>
                <span id="notif-badge" class="absolute top-0.5 right-0.5 w-2 h-2 bg-pink-500 rounded-full"></span>
            </button>

            <!-- Clock -->
            <div id="clock-display" class="font-mono font-medium text-cyan-300 bg-slate-900/60 px-2.5 py-1 rounded border border-slate-800">
                00:00:00
            </div>

            <!-- User Profile Badge -->
            <div class="flex items-center space-x-2 pl-2 border-l border-slate-800">
                <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-cyan-500 to-pink-500 flex items-center justify-center font-bold text-slate-950 text-[11px] shadow">
                    X
                </div>
                <span class="font-medium text-slate-200 hidden lg:inline">XimiK</span>
            </div>
        </div>
    </header>

    <!-- START MENU OVERLAY -->
    <div id="start-menu" class="fixed top-11 left-3 w-80 glass-panel rounded-2xl p-4 z-50 shadow-2xl border border-slate-700/60 hidden animate-window">
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-800">
            <div class="flex items-center space-x-2.5">
                <div class="w-9 h-9 rounded-xl bg-cyan-500/20 border border-cyan-500/40 flex items-center justify-center text-cyan-400">
                    <i data-lucide="command" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="font-bold text-sm text-slate-100">AiM OS Workspace</h3>
                    <p class="text-[11px] text-slate-400">v4.3.0-pro • User: XimiK</p>
                </div>
            </div>
            <button onclick="toggleStartMenu()" class="text-slate-400 hover:text-white p-1">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
        <div class="grid grid-cols-2 gap-2 mb-3">
            <button onclick="openWindow('terminal'); toggleStartMenu();" class="flex flex-col items-center justify-center p-3 rounded-xl bg-slate-900/60 hover:bg-cyan-500/10 hover:border-cyan-500/30 border border-slate-800 transition group">
                <i data-lucide="terminal" class="w-6 h-6 text-cyan-400 mb-1 group-hover:scale-110 transition"></i>
                <span class="text-xs font-medium text-slate-200">Terminal</span>
            </button>
            <button onclick="openWindow('audio'); toggleStartMenu();" class="flex flex-col items-center justify-center p-3 rounded-xl bg-slate-900/60 hover:bg-pink-500/10 hover:border-pink-500/30 border border-slate-800 transition group">
                <i data-lucide="music" class="w-6 h-6 text-pink-400 mb-1 group-hover:scale-110 transition"></i>
                <span class="text-xs font-medium text-slate-200">Audio DSP</span>
            </button>
            <button onclick="openWindow('ide'); toggleStartMenu();" class="flex flex-col items-center justify-center p-3 rounded-xl bg-slate-900/60 hover:bg-cyan-500/10 hover:border-cyan-500/30 border border-slate-800 transition group">
                <i data-lucide="code" class="w-6 h-6 text-cyan-400 mb-1 group-hover:scale-110 transition"></i>
                <span class="text-xs font-medium text-slate-200">Code IDE</span>
            </button>
            <button onclick="openWindow('hud'); toggleStartMenu();" class="flex flex-col items-center justify-center p-3 rounded-xl bg-slate-900/60 hover:bg-pink-500/10 hover:border-pink-500/30 border border-slate-800 transition group">
                <i data-lucide="activity" class="w-6 h-6 text-pink-400 mb-1 group-hover:scale-110 transition"></i>
                <span class="text-xs font-medium text-slate-200">Telemetry</span>
            </button>
        </div>
        <div class="pt-2 border-t border-slate-800 flex items-center justify-between">
            <button onclick="openWindow('settings'); toggleStartMenu();" class="flex items-center space-x-1.5 text-xs text-slate-400 hover:text-white transition">
                <i data-lucide="settings" class="w-3.5 h-3.5"></i>
                <span>Settings</span>
            </button>
            <button onclick="lockScreen()" class="flex items-center space-x-1.5 text-xs text-red-400 hover:text-red-300 transition">
                <i data-lucide="power" class="w-3.5 h-3.5"></i>
                <span>Lock / Exit</span>
            </button>
        </div>
    </div>

    <!-- NOTIFICATIONS DRAWER -->
    <div id="notif-drawer" class="fixed top-11 right-3 w-80 glass-panel rounded-2xl p-4 z-50 shadow-2xl border border-slate-700/60 hidden animate-window">
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-800">
            <h3 class="font-bold text-sm text-slate-100 flex items-center space-x-2">
                <i data-lucide="bell" class="w-4 h-4 text-cyan-400"></i>
                <span>Notifications Center</span>
            </h3>
            <button onclick="toggleNotifications()" class="text-slate-400 hover:text-white p-1">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
        <div class="space-y-2.5 max-h-64 overflow-y-auto pr-1">
            <div class="p-2.5 rounded-xl bg-slate-900/80 border border-slate-800 text-xs">
                <div class="flex justify-between items-center mb-1">
                    <span class="font-semibold text-cyan-400">Micro HUD Active</span>
                    <span class="text-[10px] text-slate-500">Just now</span>
                </div>
                <p class="text-slate-300">Pinned telemetry corner widgets enabled successfully.</p>
            </div>
            <div class="p-2.5 rounded-xl bg-slate-900/80 border border-slate-800 text-xs">
                <div class="flex justify-between items-center mb-1">
                    <span class="font-semibold text-pink-400">Synthetic CRT Screen</span>
                    <span class="text-[10px] text-slate-500">1m ago</span>
                </div>
                <p class="text-slate-300">Scanline shaders & phosphor glow pipeline operational.</p>
            </div>
        </div>
    </div>

    <!-- MAIN DESKTOP AREA -->
    <main id="desktop-area" class="flex-1 relative overflow-hidden">

        <!-- FEATURE 1: MICRO HUD (Pinned Floating Telemetry Widgets in Top-Right) -->
        <div id="micro-hud" class="absolute top-6 right-6 z-30 flex flex-col space-y-2.5 select-none pointer-events-auto">
            <!-- CPU & Network Widget -->
            <div class="glass-panel px-3.5 py-2.5 rounded-2xl border border-cyan-500/40 shadow-xl flex items-center space-x-3 glow-cyan">
                <div class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></div>
                <div class="text-[11px] font-mono">
                    <span class="text-slate-400">CPU:</span> <span id="micro-cpu" class="text-cyan-400 font-bold">32%</span>
                </div>
                <div class="h-3.5 w-[1px] bg-slate-700"></div>
                <div class="text-[11px] font-mono">
                    <span class="text-slate-400">NET:</span> <span id="micro-net" class="text-pink-400 font-bold">1.4 MB/s</span>
                </div>
            </div>
            <!-- Audio Metadata Widget -->
            <div id="micro-audio-widget" class="glass-panel px-3.5 py-2.5 rounded-2xl border border-pink-500/40 shadow-xl flex items-center space-x-2.5 glow-magenta">
                <i data-lucide="disc" class="w-4 h-4 text-pink-400 animate-spin"></i>
                <div class="text-[10px] font-mono text-pink-300 truncate max-w-[150px]" id="micro-audio-status">DSP Loop: Ready</div>
            </div>
        </div>

        <!-- DESKTOP SHORTCUTS -->
        <div class="absolute top-6 left-6 grid grid-cols-1 gap-6 z-10">
            <div onclick="openWindow('terminal')" class="group flex flex-col items-center cursor-pointer w-20 p-2 rounded-xl hover:bg-white/10 transition">
                <div class="w-12 h-12 rounded-2xl bg-cyan-500/20 border border-cyan-500/50 flex items-center justify-center text-cyan-400 shadow-[0_0_15px_rgba(6,182,212,0.2)] group-hover:scale-105 transition">
                    <i data-lucide="terminal" class="w-6 h-6"></i>
                </div>
                <span class="text-xs mt-1.5 font-medium text-slate-200 text-center drop-shadow">Terminal</span>
            </div>
            <div onclick="openWindow('audio')" class="group flex flex-col items-center cursor-pointer w-20 p-2 rounded-xl hover:bg-white/10 transition">
                <div class="w-12 h-12 rounded-2xl bg-pink-500/20 border border-pink-500/50 flex items-center justify-center text-pink-400 shadow-[0_0_15px_rgba(236,72,153,0.2)] group-hover:scale-105 transition">
                    <i data-lucide="music" class="w-6 h-6"></i>
                </div>
                <span class="text-xs mt-1.5 font-medium text-slate-200 text-center drop-shadow">Audio DSP</span>
            </div>
            <div onclick="openWindow('ide')" class="group flex flex-col items-center cursor-pointer w-20 p-2 rounded-xl hover:bg-white/10 transition">
                <div class="w-12 h-12 rounded-2xl bg-cyan-500/20 border border-cyan-500/50 flex items-center justify-center text-cyan-400 shadow-[0_0_15px_rgba(6,182,212,0.2)] group-hover:scale-105 transition">
                    <i data-lucide="code" class="w-6 h-6"></i>
                </div>
                <span class="text-xs mt-1.5 font-medium text-slate-200 text-center drop-shadow">Code IDE</span>
            </div>
            <div onclick="openWindow('hud')" class="group flex flex-col items-center cursor-pointer w-20 p-2 rounded-xl hover:bg-white/10 transition">
                <div class="w-12 h-12 rounded-2xl bg-pink-500/20 border border-pink-500/50 flex items-center justify-center text-pink-400 shadow-[0_0_15px_rgba(236,72,153,0.2)] group-hover:scale-105 transition">
                    <i data-lucide="activity" class="w-6 h-6"></i>
                </div>
                <span class="text-xs mt-1.5 font-medium text-slate-200 text-center drop-shadow">Telemetry</span>
            </div>
        </div>

        <!-- ================= WINDOW 1: TERMINAL ================= -->
        <div id="window-terminal" class="absolute top-12 left-24 w-[650px] h-[420px] glass rounded-2xl shadow-2xl flex flex-col z-30 animate-window overflow-hidden border border-cyan-500/30">
            <div class="window-header h-10 bg-slate-900/80 border-b border-slate-800 flex items-center justify-between px-3 cursor-move" onmousedown="startDrag(event, 'window-terminal')">
                <div class="flex items-center space-x-2">
                    <div class="flex items-center space-x-1.5">
                        <button onclick="closeWindow('terminal')" class="w-3 h-3 rounded-full bg-red-500 hover:opacity-80 transition"></button>
                        <button onclick="minimizeWindow('terminal')" class="w-3 h-3 rounded-full bg-yellow-500 hover:opacity-80 transition"></button>
                        <button onclick="maximizeWindow('terminal')" class="w-3 h-3 rounded-full bg-emerald-500 hover:opacity-80 transition"></button>
                    </div>
                    <span class="text-xs font-semibold text-slate-300 ml-2 flex items-center space-x-1.5">
                        <i data-lucide="terminal" class="w-3.5 h-3.5 text-cyan-400"></i>
                        <span>ximik@aim-os:~ (bash)</span>
                    </span>
                </div>
                <div class="text-[11px] text-slate-500 font-mono">zsh / x86_64</div>
            </div>
            <div id="terminal-body" class="flex-1 bg-slate-950/90 p-4 font-mono text-xs text-cyan-400 overflow-y-auto space-y-2 select-text" onclick="document.getElementById('terminal-input').focus()">
                <div class="text-slate-400">AiM OS Interactive Shell [Version 4.3.0-pro]</div>
                <div class="text-slate-400">Type <span class="text-pink-400 font-bold">help</span> to view commands, or <span class="text-cyan-300 font-bold">crt</span> to toggle CRT synthetic screen.</div>
                <div id="terminal-output" class="space-y-1"></div>
                <div class="flex items-center space-x-2 pt-1">
                    <span class="text-pink-400 font-bold">ximik@aim-os:~$</span>
                    <input id="terminal-input" type="text" class="flex-1 bg-transparent border-none outline-none text-cyan-300 font-mono text-xs" autofocus onkeydown="handleTerminalInput(event)">
                </div>
            </div>
        </div>

        <!-- ================= WINDOW 2: AUDIO DSP STUDIO ================= -->
        <div id="window-audio" class="absolute top-20 left-48 w-[720px] h-[480px] glass rounded-2xl shadow-2xl flex flex-col z-20 animate-window overflow-hidden border border-pink-500/30 hidden">
            <div class="window-header h-10 bg-slate-900/80 border-b border-slate-800 flex items-center justify-between px-3 cursor-move" onmousedown="startDrag(event, 'window-audio')">
                <div class="flex items-center space-x-2">
                    <div class="flex items-center space-x-1.5">
                        <button onclick="closeWindow('audio')" class="w-3 h-3 rounded-full bg-red-500 hover:opacity-80 transition"></button>
                        <button onclick="minimizeWindow('audio')" class="w-3 h-3 rounded-full bg-yellow-500 hover:opacity-80 transition"></button>
                        <button onclick="maximizeWindow('audio')" class="w-3 h-3 rounded-full bg-emerald-500 hover:opacity-80 transition"></button>
                    </div>
                    <span class="text-xs font-semibold text-slate-300 ml-2 flex items-center space-x-1.5">
                        <i data-lucide="music" class="w-3.5 h-3.5 text-pink-400"></i>
                        <span>Audio DSP Synthesizer & Sequencer</span>
                    </span>
                </div>
                <div class="text-[11px] text-pink-400 font-mono">Web Audio API Active</div>
            </div>
            <div class="flex-1 bg-slate-950/90 p-5 flex flex-col justify-between overflow-y-auto">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
                    <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800 flex flex-col justify-between">
                        <span class="text-xs text-slate-400 font-medium">BPM Tempo</span>
                        <div class="flex items-center justify-between mt-2">
                            <input id="bpm-slider" type="range" min="80" max="160" value="124" class="accent-pink-500 w-full" oninput="updateBPM(this.value)">
                            <span id="bpm-val" class="font-mono text-xs text-pink-400 ml-2">124</span>
                        </div>
                    </div>
                    <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800 flex flex-col justify-between">
                        <span class="text-xs text-slate-400 font-medium">Filter Cutoff</span>
                        <div class="flex items-center justify-between mt-2">
                            <input id="filter-slider" type="range" min="200" max="8000" value="3500" class="accent-cyan-500 w-full" oninput="updateFilter(this.value)">
                            <span id="filter-val" class="font-mono text-xs text-cyan-400 ml-2">3.5k</span>
                        </div>
                    </div>
                    <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800 flex flex-col justify-between">
                        <span class="text-xs text-slate-400 font-medium">Reverb Depth</span>
                        <div class="flex items-center justify-between mt-2">
                            <input id="reverb-slider" type="range" min="0" max="100" value="45" class="accent-pink-500 w-full">
                            <span class="font-mono text-xs text-pink-400 ml-2">45%</span>
                        </div>
                    </div>
                    <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800 flex items-center justify-center">
                        <button id="sequencer-play-btn" onclick="toggleSequencer()" class="w-full py-2.5 rounded-xl bg-pink-500/20 border border-pink-500/50 hover:bg-pink-500/30 text-pink-300 font-bold text-xs flex items-center justify-center space-x-2 transition shadow-[0_0_15px_rgba(236,72,153,0.3)]">
                            <i data-lucide="play" class="w-4 h-4"></i>
                            <span id="seq-play-label">START LOOP</span>
                        </button>
                    </div>
                </div>

                <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-800 mb-4">
                    <div class="flex justify-between items-center mb-3">
                        <span class="text-xs font-semibold text-slate-300">16-Step Deep House / Trap Sequencer</span>
                        <div class="flex space-x-1" id="step-indicators"></div>
                    </div>
                    <div class="space-y-2" id="sequencer-grid"></div>
                </div>

                <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800">
                    <div class="text-xs text-slate-400 mb-2 font-medium">Live Synth Pads</div>
                    <div class="grid grid-cols-8 gap-2">
                        <button onclick="playSynthNote(261.63)" class="h-12 bg-slate-800 hover:bg-pink-500/20 border border-slate-700 rounded-lg flex flex-col items-center justify-center text-xs font-mono text-pink-400 transition">C4</button>
                        <button onclick="playSynthNote(293.66)" class="h-12 bg-slate-800 hover:bg-pink-500/20 border border-slate-700 rounded-lg flex flex-col items-center justify-center text-xs font-mono text-pink-400 transition">D4</button>
                        <button onclick="playSynthNote(329.63)" class="h-12 bg-slate-800 hover:bg-pink-500/20 border border-slate-700 rounded-lg flex flex-col items-center justify-center text-xs font-mono text-pink-400 transition">E4</button>
                        <button onclick="playSynthNote(349.23)" class="h-12 bg-slate-800 hover:bg-pink-500/20 border border-slate-700 rounded-lg flex flex-col items-center justify-center text-xs font-mono text-pink-400 transition">F4</button>
