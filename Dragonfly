    async function startVideoSynthesis() {
      if (!sourceImage && !sourceImageBase64) {
        logSynthConsole(`ERROR: No source image loaded. Please upload or select sample.`);
        switchAGITab('source');
        return;
      }

      const promptInput = document.getElementById('synthesis-prompt');
      const durationSelect = document.getElementById('clip-duration');
      const styleSelect = document.getElementById('motion-style');
      const promptText = promptInput ? promptInput.value.trim() : '';
      const durationSec = durationSelect ? parseInt(durationSelect.value) : 5;
      const motionStyle = styleSelect ? styleSelect.value : 'hologram';
      clipDurationSec = durationSec;

      const startBtn = document.getElementById('btn-start-synth');
      const progressBox = document.getElementById('generation-progress-box');
      if (startBtn) startBtn.disabled = true;
      if (progressBox) progressBox.classList.remove('hidden');
      isSynthesizing = true;
      generatedFrames = [];

      const totalFrames = durationSec * 20;
      logSynthConsole(`Initiating AGI video synthesis: "${promptText}" (${durationSec}s, ${totalFrames} frames)...`);

      const synthCanvas = document.createElement('canvas');
      synthCanvas.width = 320;
      synthCanvas.height = 320;
      const ctx = synthCanvas.getContext('2d');

      let baseImg;
      try {
        baseImg = sourceImage || await loadImageAsync(sourceImageBase64);
      } catch (err) {
        logSynthConsole(`ERROR: Failed to load source image asset.`);
        if (progressBox) progressBox.classList.add('hidden');
        if (startBtn) startBtn.disabled = false;
        isSynthesizing = false;
        return;
      }

      for (let f = 0; f < totalFrames; f++) {
        const progress = f / totalFrames;
        const percent = Math.round(progress * 100);

        const statusText = document.getElementById('gen-status-text');
        const genPercent = document.getElementById('gen-percent');
        const progressBar = document.getElementById('gen-progress-bar');
        if (statusText) statusText.innerText = `SYNTHESIZING FRAME ${f + 1} / ${totalFrames}...`;
        if (genPercent) genPercent.innerText = `${percent}%`;
        if (progressBar) progressBar.style.width = `${percent}%`;

        ctx.clearRect(0, 0, 320, 320);
        ctx.save();
        ctx.translate(160, 160);
        
        if (motionStyle === 'quantum') {
          const scale = 1.0 + Math.sin(progress * Math.PI * 4) * 0.12;
          ctx.scale(scale, scale);
          ctx.rotate(Math.sin(progress * Math.PI * 2) * 0.15);
        } else if (motionStyle === 'hologram') {
          ctx.transform(1, 0, Math.sin(progress * Math.PI * 6) * 0.08, 1, 0, 0);
        } else if (motionStyle === 'organic') {
          const wave = Math.sin(progress * Math.PI * 4) * 8;
          ctx.translate(wave, wave * 0.5);
        } else {
          if (f % 5 === 0) ctx.translate((Math.random() - 0.5) * 12, (Math.random() - 0.5) * 12);
        }

        ctx.drawImage(baseImg, -160, -160, 320, 320);
        ctx.restore();

        ctx.fillStyle = `rgba(14, 165, 233, ${0.08 + Math.sin(progress * Math.PI * 8) * 0.04})`;
        ctx.fillRect(0, 0, 320, 320);
        ctx.strokeStyle = 'rgba(52, 211, 153, 0.6)';
        ctx.lineWidth = 1.5;
        ctx.strokeRect(20, 20, 280, 280);

        ctx.fillStyle = 'rgba(56, 189, 248, 0.9)';
        ctx.font = '10px "Fira Code", monospace';
        ctx.fillText(`AGI_FRAME_${f < 10 ? '0' + f : f} // 20FPS`, 28, 40);

        generatedFrames.push(synthCanvas.toDataURL('image/jpeg', 0.85));
        await new Promise(r => setTimeout(r, 10));
      }

      isSynthesizing = false;
      if (progressBox) progressBox.classList.add('hidden');
      if (startBtn) startBtn.disabled = false;
      logSynthConsole(`SUCCESS: Generated ${totalFrames} frames ready.`);
      sfx.playSuccessChime();

      switchAGITab('player');
      initVideoPlayer();
    }

