    function exportVideoClip(format) {
      if (generatedFrames.length === 0) {
        alert('No generated video clip available for export.');
        return;
      }
      logSynthConsole(`Packaging video clip container as .${format.toUpperCase()}...`);

      const canvas = document.getElementById('clipCanvas');
      if (!canvas || typeof canvas.captureStream !== 'function') {
        fallbackStaticExport(format);
        return;
      }

      try {
        const stream = canvas.captureStream(20);
        const options = { mimeType: 'video/webm;codecs=vp9' };
        const supportedMime = MediaRecorder.isTypeSupported(options.mimeType) ? options.mimeType : 'video/webm';

        mediaRecorder = new MediaRecorder(stream, { mimeType: supportedMime });
        recordedChunks = [];

        mediaRecorder.ondataavailable = e => { if (e.data && e.data.size > 0) recordedChunks.push(e.data); };
        mediaRecorder.onstop = () => {
          const blob = new Blob(recordedChunks, { type: supportedMime });
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = `QuantumAGI_Clip_${Date.now()}.${format === 'mp4' ? 'mp4' : 'webm'}`;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          URL.revokeObjectURL(url);
          logSynthConsole(`SUCCESS: True video export saved.`);
        };

        mediaRecorder.start();
        restartVideo();
        if (!isPlayingClip) toggleVideoPlayback();

        setTimeout(() => {
          if (mediaRecorder && mediaRecorder.state === 'recording') {
            mediaRecorder.stop();
            if (isPlayingClip) toggleVideoPlayback();
          }
        }, clipDurationSec * 1000);
      } catch (err) {
        fallbackStaticExport(format);
      }
    }

