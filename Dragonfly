    let agiScene, agiCamera, agiRenderer;
    let agiTissueMesh, agiTissueUniforms;
    let agiDragonflies = [];
    let agiSwarmInit = false;
    let agiIsDragging = false;
    let agiPrevMouse = { x: 0, y: 0 };
    let agiTargetRot = { x: 0, y: 0 };

    function initAGISwarmOS() {
      const wrapper = document.getElementById('canvas-wrapper');
      if (!wrapper) return;
      const width = wrapper.clientWidth || 400;
      const height = wrapper.clientHeight || 200;

      if (!agiSwarmInit) {
        agiSwarmInit = true;
        agiScene = new THREE.Scene();
        agiScene.fog = new THREE.FogExp2(0x020617, 0.022);

        agiCamera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
        agiCamera.position.set(0, -18, 25);
        agiCamera.lookAt(0, 0, 0);

        const canvasEl = document.getElementById('simCanvasAGI');
        if (!canvasEl) return;
        agiRenderer = new THREE.WebGLRenderer({ canvas: canvasEl, antialias: true, alpha: true });
        agiRenderer.setSize(width, height);
        agiRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        const tissueGeo = new THREE.PlaneGeometry(24, 24, 32, 32);
        agiTissueUniforms = {
          uTime: { value: 0 },
          uTouchPos: { value: new THREE.Vector2(0.5, 0.5) },
          uTouchTime: { value: -10.0 }
        };

        const tissueMat = new THREE.ShaderMaterial({
          uniforms: agiTissueUniforms,
          wireframe: false,
          transparent: true,
          side: THREE.DoubleSide,
          vertexShader: `
            uniform float uTime;
            uniform vec2 uTouchPos;
            uniform float uTouchTime;
            varying vec2 vUv;
            varying float vElevation;
            void main() {
              vUv = uv;
              vec3 pos = position;
              float wave1 = sin(pos.x * 0.35 + uTime * 1.5) * cos(pos.y * 0.35 + uTime * 1.3);
              float dist = distance(vUv, uTouchPos);
              float timeSinceTouch = uTime - uTouchTime;
              if (timeSinceTouch > 0.0 && timeSinceTouch < 3.0) {
                float ripple = sin(dist * 25.0 - timeSinceTouch * 8.0) * exp(-timeSinceTouch * 1.5) * exp(-dist * 3.0);
                wave1 += ripple * 2.2;
              }
              pos.z += wave1 * 0.7;
              vElevation = wave1;
              gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
            }
          `,
          fragmentShader: `
            uniform float uTime;
            varying vec2 vUv;
            varying float vElevation;
            void main() {
              vec3 deepVoid = vec3(0.02, 0.06, 0.14);
              vec3 bioEmerald = vec3(0.05, 0.65, 0.42);
              float mixFactor = smoothstep(-1.2, 1.2, vElevation);
              vec3 baseColor = mix(deepVoid, bioEmerald, mixFactor);
              vec2 grid = abs(fract(vUv * 14.0 - 0.5) - 0.5) / fwidth(vUv * 14.0);
              float line = min(grid.x, grid.y);
              float cellBorder = 1.0 - min(line, 1.0);
              vec3 finalColor = mix(baseColor, vec3(0.06, 0.85, 0.95) * 1.5, cellBorder * 0.4);
              gl_FragColor = vec4(finalColor * (0.8 + 0.2 * sin(uTime * 4.0)), 0.9);
            }
          `
        });

        agiTissueMesh = new THREE.Mesh(tissueGeo, tissueMat);
        agiScene.add(agiTissueMesh);

        const dragonflyGeo = new THREE.ConeGeometry(0.25, 0.8, 6);
        dragonflyGeo.rotateX(Math.PI / 2);

        for (let i = 0; i < 12; i++) {
          const mat = new THREE.MeshBasicMaterial({
            color: i % 3 === 0 ? 0x38bdf8 : (i % 3 === 1 ? 0x10b981 : 0xf59e0b),
            transparent: true, opacity: 0.9
          });
          const mesh = new THREE.Mesh(dragonflyGeo, mat);
          agiScene.add(mesh);
          agiDragonflies.push({ mesh: mesh, pos: new THREE.Vector3() });
        }

        canvasEl.addEventListener('pointerdown', (e) => {
          agiIsDragging = true;
          agiPrevMouse = { x: e.clientX, y: e.clientY };
          const rect = canvasEl.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width;
          const y = 1.0 - ((e.clientY - rect.top) / rect.height);
          if (agiTissueUniforms) {
            agiTissueUniforms.uTouchPos.value.set(x, y);
            agiTissueUniforms.uTouchTime.value = performance.now() * 0.001;
          }
          logSynthConsole(`Neural node injected at UV (${x.toFixed(2)}, ${y.toFixed(2)}).`);
        });

        canvasEl.addEventListener('pointermove', (e) => {
          if (!agiIsDragging) return;
          agiTargetRot.y += (e.clientX - agiPrevMouse.x) * 0.008;
          agiTargetRot.x += (e.clientY - agiPrevMouse.y) * 0.008;
          agiTargetRot.x = Math.max(-Math.PI / 3, Math.min(Math.PI / 3, agiTargetRot.x));
          agiPrevMouse = { x: e.clientX, y: e.clientY };
        });

        window.addEventListener('pointerup', () => { agiIsDragging = false; });
        requestAnimationFrame(animateAGISwarm);
      } else {
        const w = wrapper.clientWidth || 400;
        const h = wrapper.clientHeight || 200;
        agiCamera.aspect = w / h;
        agiCamera.updateProjectionMatrix();
        agiRenderer.setSize(w, h);
      }
    }

    function animateAGISwarm(now) {
      requestAnimationFrame(animateAGISwarm);
      const timeSec = now * 0.001;
      if (agiTissueUniforms) agiTissueUniforms.uTime.value = timeSec;
      if (agiTissueMesh) {
        agiTissueMesh.rotation.y += (agiTargetRot.y - agiTissueMesh.rotation.y) * 0.1;
        agiTissueMesh.rotation.x += (agiTargetRot.x - agiTissueMesh.rotation.x) * 0.1;
      }
      agiDragonflies.forEach((df, idx) => {
        const angle = timeSec * 1.5 + idx * (Math.PI * 2 / agiDragonflies.length);
        df.pos.set(Math.cos(angle) * 7.5, Math.sin(angle * 0.8) * 7.5, 1.5 + Math.sin(timeSec + idx) * 0.8);
        df.mesh.position.copy(df.pos);
        df.mesh.rotation.z = timeSec * 8 + idx;
      });
      if (agiRenderer && agiScene && agiCamera) agiRenderer.render(agiScene, agiCamera);
    }

    function triggerSwarmHunt() { logSynthConsole(`Swarm Hunt protocol synchronized.`); }
    function triggerSyntheticPulse() { logSynthConsole(`Synthetic bio-resonance pulse emitted.`); }
    function resetSwarmMatrix() { 
      agiTargetRot.x = 0; agiTargetRot.y = 0;
      logSynthConsole(`Swarm telemetry matrix reset.`); 
    }

    // --- OS Window Management ---
    let openWindows = {};
    let zIndexCounter = 100;
    let activeAppId = null;

    function renderDock() {
      const dock = document.getElementById('dock-bar');
      if (!dock) return;
      dock.innerHTML = ModuleRegistry.getAll().map(mod => {
        const isOpen = Boolean(openWindows[mod.id]);
        return `
          <button onclick="handleDockClick('${mod.id}')" title="${mod.name}" class="dock-item relative group flex flex-col items-center cursor-pointer">
            <span class="opacity-0 group-hover:opacity-100 transition-opacity absolute -top-10 px-2.5 py-1 rounded-xl glass-surface text-[11px] font-medium whitespace-nowrap pointer-events-none shadow-lg">${mod.name}</span>
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br ${mod.gradient} flex items-center justify-center shadow-lg border border-white/25">${mod.icon}</div>
            <span class="w-1.5 h-1.5 rounded-full mt-1.5 transition-all ${isOpen ? 'bg-white opacity-100' : 'opacity-0'}"></span>
          </button>
        `;
      }).join('');
      lucide.createIcons();
    }

    function renderSystemMenu() {
      const menu = document.getElementById('registry-menu-list');
      if (!menu) return;
      menu.innerHTML = ModuleRegistry.getAll().map(mod => `
        <button onclick="openApp('${mod.id}'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer text-slate-200 font-bold">
          <span>${mod.name}</span>
          <span class="font-mono text-[10px] text-cyan-300">v${mod.version}</span>
        </button>
      `).join('');
    }

    function closeMenus() { document.getElementById('system-menu')?.classList.add('hidden'); }

    function renderDesktopIcons() {
      const grid = document.getElementById('desktop-icons');
      if (!grid) return;
      grid.innerHTML = ModuleRegistry.getAll().map(mod => `
        <button ondblclick="openApp('${mod.id}')" class="desktop-icon group w-28 p-2.5 rounded-2xl hover:bg-white/15 transition flex flex-col items-center gap-1.5 text-center cursor-pointer">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br ${mod.gradient} flex items-center justify-center shadow-lg">${mod.icon}</div>
          <span class="text-xs font-medium drop-shadow leading-tight">${mod.name}</span>
        </button>
      `).join('');
      lucide.createIcons();
    }

    function handleDockClick(appId) {
      if (!openWindows[appId]) openApp(appId);
      else if (openWindows[appId].minimized) restoreWindow(appId);
      else if (activeAppId === appId) minimizeWindow(appId);
      else focusWindow(appId);
    }

    function openApp(appId) {
      const mod = ModuleRegistry.get(appId);
      if (!mod) return;
      if (openWindows[appId]) { restoreWindow(appId); focusWindow(appId); return; }

      const layer = document.getElementById('windows-layer');
      const w = Math.min(window.innerWidth - 40, mod.width);
      const h = Math.min(window.innerHeight - 100, mod.height);
      const left = Math.max(20, (window.innerWidth - w) / 2);
      const top = Math.max(45, (window.innerHeight - h) / 2);

      const winEl = document.createElement('div');
      winEl.id = `win-${appId}`;
      winEl.className = 'window-frame glass-surface rounded-3xl flex flex-col overflow-hidden pointer-events-auto absolute shadow-2xl';
      winEl.style.width = `${w}px`; winEl.style.height = `${h}px`;
      winEl.style.left = `${left}px`; winEl.style.top = `${top}px`;
      winEl.style.zIndex = ++zIndexCounter;
      winEl.addEventListener('mousedown', () => focusWindow(appId));

      winEl.innerHTML = `
        <div class="win-header h-11 px-4 flex items-center justify-between border-b border-white/15 bg-white/5 cursor-grab shrink-0">
          <div class="flex items-center gap-2">
            <button onclick="closeWindow('${appId}')" class="w-3.5 h-3.5 rounded-full bg-rose-500 hover:bg-rose-400 cursor-pointer"></button>
            <button onclick="minimizeWindow('${appId}')" class="w-3.5 h-3.5 rounded-full bg-amber-400 hover:bg-amber-300 cursor-pointer"></button>
            <button onclick="toggleMaximizeWindow('${appId}')" class="w-3.5 h-3.5 rounded-full bg-emerald-400 hover:bg-emerald-300 cursor-pointer"></button>
          </div>
          <div class="text-xs font-semibold">${mod.name} <span class="opacity-60 font-mono text-[10px]">(${mod.category})</span></div>
          <div></div>
        </div>
        <div class="flex-1 overflow-auto p-4 text-xs">${mod.render()}</div>
      `;

      layer.appendChild(winEl);
      openWindows[appId] = { id: appId, minimized: false };
      makeWindowDraggable(winEl);
      focusWindow(appId);
      renderDock();
      
      if (appId === 'dragonflysim') initFlightSimulation('flightSimCanvas');
    }

    function focusWindow(appId) {
      const win = document.getElementById(`win-${appId}`);
      if (!win) return;
      win.style.zIndex = ++zIndexCounter;
      activeAppId = appId;
      const mod = ModuleRegistry.get(appId);
      if (mod) {
        document.getElementById('active-app-label').textContent = `${mod.name} • Active`;
      }
    }

    function closeWindow(appId) { document.getElementById(`win-${appId}`)?.remove(); delete openWindows[appId]; renderDock(); }
    function minimizeWindow(appId) { document.getElementById(`win-${appId}`)?.classList.add('window-minimized'); openWindows[appId].minimized = true; renderDock(); }
    function restoreWindow(appId) { document.getElementById(`win-${appId}`)?.classList.remove('window-minimized'); openWindows[appId].minimized = false; focusWindow(appId); renderDock(); }
    function toggleMaximizeWindow(appId) {
      const win = document.getElementById(`win-${appId}`);
      if (!win) return;
      if (!win.dataset.maximized) {
        win.dataset.prev = JSON.stringify({ left: win.style.left, top: win.style.top, width: win.style.width, height: win.style.height });
        win.style.left = '10px'; win.style.top = '44px';
        win.style.width = `${window.innerWidth - 20}px`; win.style.height = `${window.innerHeight - 110}px`;
        win.dataset.maximized = 'true';
      } else {
        const prev = JSON.parse(win.dataset.prev);
        win.style.left = prev.left; win.style.top = prev.top; win.style.width = prev.width; win.style.height = prev.height;
        delete win.dataset.maximized;
      }
    }

    function makeWindowDraggable(winEl) {
      const header = winEl.querySelector('.win-header');
      header.addEventListener('mousedown', e => {
        if (e.target.tagName === 'BUTTON') return;
        const startX = e.clientX, startY = e.clientY;
        const startLeft = winEl.offsetLeft, startTop = winEl.offsetTop;
        winEl.classList.add('dragging');
        const onMove = ev => {
          winEl.style.left = `${Math.max(0, startLeft + (ev.clientX - startX))}px`;
          winEl.style.top = `${Math.max(40, startTop + (ev.clientY - startY))}px`;
        };
        const onUp = () => { winEl.classList.remove('dragging'); window.removeEventListener('mousemove', onMove); window.removeEventListener('mouseup', onUp); };
        window.addEventListener('mousemove', onMove); window.addEventListener('mouseup', onUp);
      });
    }

    // --- Wallpaper Biomorphic Fractal Shader ---
    const wallpaperVS = `varying vec2 vUv; void main() { vUv = uv; gl_Position = vec4(position, 1.0); }`;
    const wallpaperFS = `
      uniform float u_time;
      uniform vec2 u_resolution;
      uniform float u_bass;
      uniform float u_mids;
      uniform float u_treble;
      varying vec2 vUv;
      #define PI 3.14159265359

      vec2 complexMul(vec2 a, vec2 b) {
        return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
      }

      void main() {
        vec2 st = (gl_FragCoord.xy - 0.5 * u_resolution.xy) / min(u_resolution.x, u_resolution.y);
        float time = u_time * 0.1;
        float r = length(st);
        
        vec2 z = st;
        float accum = 0.0;
        float scale = 1.0;
        for (int i = 0; i < 4; i++) {
          float angle = atan(z.y, z.x);
          float rad = length(z);
          angle = mod(angle + PI / 3.0 + time * 0.2, 2.0 * PI / 3.0) - PI / 3.0;
          z = vec2(cos(angle), sin(angle)) * rad;
          z = abs(z) - vec2(0.28, 0.14) * (1.0 + u_mids * 0.25);
          z = complexMul(z, z) - vec2(0.38, 0.08);
          accum += sin(z.x * 4.0 + time) * cos(z.y * 4.0 - time) / scale;
          scale *= 1.25;
        }

        vec3 colTeal = vec3(0.01, 0.06, 0.18);
        vec3 colOrange = vec3(0.12, 0.52, 0.95);
        vec3 color = mix(colTeal, colOrange, clamp(abs(accum) * 1.3 + r * 0.3, 0.0, 1.0));
        color += vec3(0.0, 0.8, 1.0) * (0.05 / (r + 0.02 + u_bass * 0.2));

        gl_FragColor = vec4(color * (1.0 - r * 0.25), 1.0);
      }
    `;

    function initWallpaperShader() {
      const canvas = document.getElementById('wallpaper-canvas');
      if (!canvas) return;
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      const scene = new THREE.Scene();
      const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
      const uniforms = {
        u_time: { value: 0.0 },
        u_resolution: { value: new THREE.Vector2(window.innerWidth, window.innerHeight) },
        u_bass: { value: 0.0 },
        u_mids: { value: 0.0 },
        u_treble: { value: 0.0 }
      };
      const material = new THREE.ShaderMaterial({ vertexShader: wallpaperVS, fragmentShader: wallpaperFS, uniforms });
      scene.add(new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material));
      window.addEventListener('resize', () => { renderer.setSize(window.innerWidth, window.innerHeight); uniforms.u_resolution.value.set(window.innerWidth, window.innerHeight); });
      const clock = new THREE.Clock();
      (function animate() {
        requestAnimationFrame(animate);
        uniforms.u_time.value = clock.getElapsedTime();
        sovereignAudioEngine.update();
        uniforms.u_bass.value = sovereignAudioEngine.metrics.bass;
        uniforms.u_mids.value = sovereignAudioEngine.metrics.mids;
        uniforms.u_treble.value = sovereignAudioEngine.metrics.treble;
        renderer.render(scene, camera);
      })();
    }

    // --- Initialize 3D Flight Simulation ---
    function initFlightSimulation(canvasId) {
      const canvas = document.getElementById(canvasId);
      if (!canvas) return;
      const container = canvas.parentElement;

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
      renderer.setSize(container.clientWidth, container.clientHeight);

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x020617);
      scene.fog = new THREE.FogExp2(0x020617, 0.018);

      const camera = new THREE.PerspectiveCamera(50, container.clientWidth / container.clientHeight, 0.1, 1000);

      scene.add(new THREE.AmbientLight(0xd9f6ff, 0.8));
      const sun = new THREE.DirectionalLight(0x00f3ff, 1.2);
      sun.position.set(20, 40, 20);
      scene.add(sun);

      const waterGeo = new THREE.PlaneGeometry(250, 250, 32, 32);
      const waterMat = new THREE.MeshStandardMaterial({ color: 0x041525, roughness: 0.1, metalness: 0.8 });
      const water = new THREE.Mesh(waterGeo, waterMat);
      water.rotation.x = -Math.PI / 2;
      scene.add(water);

      const dragonflyRig = new DragonflyRig(scene);
      const flightController = new DragonflyFlightController(dragonflyRig);

      window.addEventListener('keydown', e => {
        if (e.key === 'w' || e.key === 'ArrowUp') flightController.controls.throttle = Math.min(1.0, flightController.controls.throttle + 0.15);
        if (e.key === 's' || e.key === 'ArrowDown') flightController.controls.throttle = Math.max(0.1, flightController.controls.throttle - 0.15);
        if (e.key === 'a' || e.key === 'ArrowLeft') flightController.controls.yawInput = 1.4;
        if (e.key === 'd' || e.key === 'ArrowRight') flightController.controls.yawInput = -1.4;
      });

      const clock = new THREE.Clock();
      (function animateSim() {
        requestAnimationFrame(animateSim);
        const delta = Math.min(clock.getDelta(), 0.1);
        flightController.update(delta);

        const targetCamPos = flightController.position.clone().sub(new THREE.Vector3(0, 0, 10).applyAxisAngle(new THREE.Vector3(0,1,0), flightController.heading)).add(new THREE.Vector3(0, 3, 0));
        camera.position.lerp(targetCamPos, 0.1);
        camera.lookAt(flightController.position.clone().add(new THREE.Vector3(0, 1, 0)));

        const hud = document.getElementById('hud-telemetry');
        if (hud) {
          hud.textContent = `Speed: ${flightController.velocity.length().toFixed(1)} m/s | Alt: ${flightController.position.y.toFixed(1)}m`;
        }

        renderer.render(scene, camera);
      })();
    }

    window.addEventListener('DOMContentLoaded', () => {
      renderDock();
      renderSystemMenu();
      renderDesktopIcons();
      initWallpaperShader();
      setTimeout(() => openApp('agisynth'), 300);
      setTimeout(() => openApp('sovereign_eq'), 600);
    });
  </script>
