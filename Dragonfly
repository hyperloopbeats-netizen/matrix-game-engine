      <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-cyan-500/20 border border-cyan-400/30 text-[10px] text-cyan-300 font-mono">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
        <span>AGI SYNTH & KINETIC AUDIO ACTIVE</span>
      </div>
