<!DOCTYPE html>
<html lang="en" class="h-full select-none bg-black">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>AIM OS v12.0 — Quantum Dragonfly AGI & Sovereign Liquid EQ Workspace</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Three.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Orbitron:wght@400;600;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
            orbitron: ['Orbitron', 'sans-serif'],
            cinzel: ['Cinzel', 'serif'],
            'mono-code': ['Fira Code', 'monospace']
          }
        }
      }
    }
  </script>
  <style>
    :root {
      --glass-blur: 24px;
      --glass-bg: rgba(15, 23, 42, 0.85);
      --glass-bg-elevated: rgba(15, 23, 42, 0.95);
      --glass-border: rgba(56, 189, 248, 0.35);
      --glass-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.75);
      --text-primary: #f8fafc;
      --panel-inner: rgba(2, 6, 23, 0.7);
    }

    * { box-sizing: border-box; user-select: none; }
    input, textarea, pre, code, .selectable { user-select: text; }

    body {
      margin: 0; padding: 0; overflow: hidden; width: 100vw; height: 100vh;
      font-family: 'Inter', sans-serif; color: var(--text-primary); background-color: #020617;
      touch-action: pan-y;
    }

    #wallpaper-canvas {
      position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: -1; pointer-events: none;
    }

    .glass-surface {
      background: var(--glass-bg);
      backdrop-filter: blur(var(--glass-blur)) saturate(180%);
      -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(180%);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-shadow);
    }
    .glass-bar {
      background: var(--glass-bg-elevated);
      backdrop-filter: blur(28px) saturate(190%);
      -webkit-backdrop-filter: blur(28px) saturate(190%);
      border-bottom: 1px solid var(--glass-border);
    }
    .glass-inner { background: var(--panel-inner); border: 1px solid rgba(255, 255, 255, 0.12); }

    .window-frame { transition: opacity 0.2s ease, transform 0.22s cubic-bezier(0.16, 1, 0.3, 1); }
    .window-frame.dragging { transition: none !important; }
    .window-minimized { opacity: 0; transform: scale(0.86) translateY(60px); pointer-events: none; }

    .glass-dock {
      background: var(--glass-bg-elevated);
      backdrop-filter: blur(32px) saturate(195%);
      -webkit-backdrop-filter: blur(32px) saturate(195%);
      border: 1px solid var(--glass-border);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    }
    .dock-item {
      transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), margin 0.22s ease;
    }
    .dock-item:hover {
      transform: translateY(-12px) scale(1.25);
      margin-left: 8px;
      margin-right: 8px;
    }

    .swarm-pill {
      background: linear-gradient(135deg, rgba(14, 165, 233, 0.22) 0%, rgba(3, 105, 161, 0.6) 100%);
      backdrop-filter: blur(14px);
      border: 1px solid rgba(56, 189, 248, 0.55);
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .swarm-pill:active { transform: scale(0.95); }
    .swarm-pill.active-pill {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.35) 0%, rgba(6, 95, 70, 0.85) 100%);
      border-color: rgba(52, 211, 153, 0.85);
      box-shadow: 0 0 18px rgba(16, 185, 129, 0.4);
    }

    input[type=range] {
      -webkit-appearance: none; background: rgba(255, 255, 255, 0.12); height: 5px; border-radius: 3px;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none; height: 16px; width: 16px; border-radius: 50%;
      background: #bae6fd; box-shadow: 0 0 12px #38bdf8; cursor: pointer; transition: transform 0.1s;
    }
    input[type=range]::-webkit-slider-thumb:hover { transform: scale(1.2); }

    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(56, 189, 248, 0.35); border-radius: 9999px; }

    @keyframes scanline {
      0% { transform: translateY(-100%); }
      100% { transform: translateY(1000%); }
    }
    .animate-scanline { animation: scanline 3s linear infinite; }
  </style>
</head>
<body class="select-none">

  <!-- Live Biomorphic Wing-Membrane Shader Wallpaper -->
  <canvas id="wallpaper-canvas"></canvas>

  <!-- Top Status Bar -->
  <header class="glass-bar fixed top-0 left-0 right-0 h-9 px-4 flex items-center justify-between z-[1000] text-xs font-medium">
    <div class="flex items-center gap-3">
      <button onclick="toggleMenu('system-menu')" class="flex items-center gap-2 px-2 py-1 rounded-lg hover:bg-white/15 transition cursor-pointer">
