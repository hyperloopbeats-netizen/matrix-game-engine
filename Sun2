<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Sentient Sun OS - Sovereign Desktop & Fractal Core</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');

        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden;
            background-color: #020617; font-family: 'Inter', sans-serif; color: #e0f2fe;
            user-select: none; -webkit-user-select: none;
        }
        .font-cinzel { font-family: 'Cinzel', serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        
        .glass-panel {
            background: rgba(4, 10, 22, 0.85);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
            border: 1px solid rgba(186, 230, 253, 0.18);
            box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.95), inset 0 1px 0 rgba(255, 255, 255, 0.15);
        }
        .glass-button {
            background: rgba(186, 230, 253, 0.08);
            border: 1px solid rgba(186, 230, 253, 0.22);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-button:hover { background: rgba(186, 230, 253, 0.18); border-color: rgba(186, 230, 253, 0.45); }
        .glass-button:active { background: rgba(186, 230, 253, 0.3); transform: scale(0.97); }
        
        input[type=range] {
            -webkit-appearance: none; background: rgba(255, 255, 255, 0.12); height: 5px; border-radius: 3px;
        }
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none; height: 16px; width: 16px; border-radius: 50%;
            background: #bae6fd; box-shadow: 0 0 12px #38bdf8; cursor: pointer; transition: transform 0.1s;
        }
        input[type=range]::-webkit-slider-thumb:hover { transform: scale(1.25); }
        
        .vignette {
            pointer-events: none; position: absolute; inset: 0;
            background: radial-gradient(circle at 50% 50%, transparent 20%, rgba(2, 6, 23, 0.94) 100%);
        }
        
        /* Window Management Styles */
        .os-window {
            position: absolute;
            display: flex;
            flex-direction: column;
            border-radius: 1.5rem;
            overflow: hidden;
            transition: opacity 0.25s ease, transform 0.25s ease;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.8);
        }
        .os-window.minimized {
            opacity: 0;
            pointer-events: none;
            transform: scale(0.85) translateY(40px);
        }
        .window-header {
            cursor: grab;
        }
        .window-header:active {
            cursor: grabbing;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); }
        ::-webkit-scrollbar-thumb { background: rgba(186,230,253,0.3); border-radius: 2px; }

        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 15px rgba(56, 189, 248, 0.4); }
            50% { box-shadow: 0 0 30px rgba(251, 191, 36, 0.7); }
        }
        .ai-glow { animation: pulse-glow 4s infinite ease-in-out; }
    </style>
</head>
<body class="relative flex flex-col w-full h-full bg-slate-950 overflow-hidden">

    <!-- WebGL Background Canvas Container -->
    <div id="canvas-container" class="absolute inset-0 w-full h-full flex items-center justify-center overflow-hidden z-0">
        <canvas id="glCanvas" class="w-full h-full block cursor-crosshair touch-none"></canvas>
        <div class="vignette"></div>
        
        <!-- Drag & Drop Global Audio Overlay -->
        <div id="drop-overlay" class="absolute inset-0 bg-cyan-950/85 backdrop-blur-md z-50 flex flex-col items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 border-4 border-dashed border-cyan-400 m-8 rounded-3xl">
            <i data-lucide="upload-cloud" class="w-20 h-20 text-cyan-300 animate-bounce mb-4"></i>
            <h2 class="font-cinzel text-2xl font-bold text-slate-100 tracking-wider">Inject Audio Track into Sovereign OS</h2>
            <p class="text-sm text-cyan-300/80 mt-2 font-mono">Supports MP3, WAV, FLAC, AAC</p>
        </div>
    </div>

    <!-- Hidden File Input -->
    <input type="file" id="audioFileInput" accept="audio/*" class="hidden">

    <!-- Toast Notification System -->
    <div id="toast" class="absolute top-6 left-1/2 -translate-x-1/2 z-50 px-5 py-2.5 rounded-2xl glass-panel text-cyan-200 text-xs font-medium tracking-wide shadow-2xl transition-all duration-300 opacity-0 pointer-events-none translate-y-[-15px] flex items-center space-x-2.5 border border-cyan-500/40">
        <i data-lucide="info" class="w-4 h-4 text-cyan-400"></i>
        <span id="toast-msg">System notification</span>
    </div>

    <!-- TOP MENU BAR -->
    <div class="relative z-30 flex items-center justify-between px-6 py-3 glass-panel border-b border-cyan-500/20 text-xs shadow-lg">
        <div class="flex items-center space-x-4">
            <div class="flex items-center space-x-2.5">
                <div class="w-3 h-3 rounded-full bg-amber-400 animate-ping"></div>
                <span class="font-cinzel font-bold tracking-widest text-slate-100 text-sm">SENTIENT SUN OS</span>
            </div>
            <span class="text-slate-500">|</span>
            <span id="os-status-text" class="text-cyan-400 font-mono text-[11px] uppercase tracking-wider">Solar Core: Optimal (60Hz)</span>
        </div>

        <div class="flex items-center space-x-4 text-slate-300 font-mono text-[11px]">
            <div class="hidden sm:flex items-center space-x-2">
                <i data-lucide="cpu" class="w-3.5 h-3.5 text-amber-400"></i>
                <span id="topbar-cpu">CPU: 14%</span>
            </div>
            <div class="hidden sm:flex items-center space-x-2">
                <i data-lucide="activity" class="w-3.5 h-3.5 text-cyan-400"></i>
                <span id="topbar-ram">RAM: 4.2 GB</span>
            </div>
            <div class="px-2.5 py-1 rounded-lg bg-cyan-950/60 border border-cyan-500/30 text-cyan-200 font-semibold" id="live-clock">
                12:00 PM
            </div>
        </div>
    </div>

    <!-- DESKTOP WORKSPACE / WINDOW CONTAINER -->
    <div id="desktop-workspace" class="relative flex-1 w-full h-full overflow-hidden pointer-events-auto z-20">

        <!-- 1. SOVEREIGN EQ WINDOW -->
        <div id="win-eq" class="os-window glass-panel w-[92%] sm:w-[500px] top-12 left-6 sm:left-12 max-h-[82vh] z-30">
            <div class="window-header flex items-center justify-between px-4 py-3 border-b border-cyan-500/20 bg-black/40">
                <div class="flex items-center space-x-2">
                    <i data-lucide="disc" class="w-4 h-4 text-cyan-400 animate-spin" style="animation-duration: 4s;"></i>
                    <span class="font-cinzel font-semibold text-xs text-cyan-200 tracking-wider">AIM EQ & Liquid Core</span>
                </div>
                <div class="flex items-center space-x-1.5">
                    <button onclick="minimizeWindow('win-eq')" class="p-1.5 rounded-lg text-slate-400 hover:text-white glass-button"><i data-lucide="minus" class="w-3.5 h-3.5"></i></button>
                    <button onclick="closeWindow('win-eq')" class="p-1.5 rounded-lg text-slate-400 hover:text-red-400 glass-button"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
                </div>
            </div>
            <div class="p-4 space-y-3.5 overflow-y-auto text-xs">
                <div class="flex items-center justify-between bg-black/30 p-2.5 rounded-2xl border border-white/5">
                    <div class="flex items-center space-x-2">
                        <span id="eq-status-badge" class="px-2 py-0.5 rounded bg-cyan-950/90 text-cyan-300 border border-cyan-500/30 font-mono text-[10px]">READY</span>
                        <span id="track-title-display" class="text-slate-300 truncate max-w-[200px]">No Audio Loaded</span>
                    </div>
                    <div class="flex space-x-1.5">
                        <button id="upload-btn" class="glass-button px-2.5 py-1.5 rounded-xl text-cyan-300 flex items-center space-x-1">
                            <i data-lucide="upload" class="w-3.5 h-3.5"></i><span>Load</span>
                        </button>
                        <button id="demo-synth-btn" class="glass-button px-2.5 py-1.5 rounded-xl text-emerald-300 flex items-center space-x-1 bg-emerald-950/40 border-emerald-500/40">
                            <i data-lucide="play" class="w-3.5 h-3.5"></i><span id="synth-btn-text">Synth</span>
                        </button>
                    </div>
                </div>

                <!-- Presets -->
                <div class="grid grid-cols-4 gap-1.5">
                    <button data-preset="warm" class="preset-btn px-2 py-1.5 rounded-xl glass-button text-amber-200 font-medium text-left flex flex-col border-amber-500/20 hover:border-amber-400/50">
                        <span class="font-semibold text-[10px]">Warm</span>
                        <span class="text-[8px] text-slate-400">Tube Boost</span>
                    </button>
                    <button data-preset="space" class="preset-btn px-2 py-1.5 rounded-xl glass-button text-cyan-200 font-medium text-left flex flex-col border-cyan-500/20 hover:border-cyan-400/50">
                        <span class="font-semibold text-[10px]">Space</span>
                        <span class="text-[8px] text-slate-400">Air Highs</span>
                    </button>
                    <button data-preset="solar" class="preset-btn px-2 py-1.5 rounded-xl glass-button text-orange-200 font-medium text-left flex flex-col border-orange-500/20 hover:border-orange-400/50">
                        <span class="font-semibold text-[10px]">Solar</span>
                        <span class="text-[8px] text-slate-400">Sat Drive</span>
                    </button>
                    <button data-preset="cyber" class="preset-btn px-2 py-1.5 rounded-xl glass-button text-emerald-200 font-medium text-left flex flex-col border-emerald-500/20 hover:border-emerald-400/50">
                        <span class="font-semibold text-[10px]">Cyber</span>
                        <span class="text-[8px] text-slate-400">Punchy Mids</span>
                    </button>
                </div>

                <!-- Sliders Grid -->
                <div class="grid grid-cols-2 gap-2.5">
                    <div class="space-y-1 bg-black/40 p-2.5 rounded-2xl border border-white/5">
                        <div class="flex justify-between text-slate-300">
                            <span>Tube Drive</span>
                            <span id="drive-val" class="text-amber-300 font-mono">15%</span>
                        </div>
                        <input type="range" id="drive-range" min="0" max="100" step="1" value="15" class="w-full accent-amber-400">
                    </div>
                    <div class="space-y-1 bg-black/40 p-2.5 rounded-2xl border border-white/5">
                        <div class="flex justify-between text-slate-300">
                            <span>Low (100Hz)</span>
                            <span id="low-val" class="text-cyan-300 font-mono">0.0 dB</span>
                        </div>
                        <input type="range" id="low-range" min="-15" max="15" step="0.5" value="0" class="w-full accent-cyan-400">
                    </div>
                    <div class="space-y-1 bg-black/40 p-2.5 rounded-2xl border border-white/5">
                        <div class="flex justify-between text-slate-300">
                            <span>Mid (1kHz)</span>
                            <span id="mid-val" class="text-cyan-300 font-mono">0.0 dB</span>
                        </div>
                        <input type="range" id="mid-range" min="-15" max="15" step="0.5" value="0" class="w-full accent-cyan-400">
                    </div>
                    <div class="space-y-1 bg-black/40 p-2.5 rounded-2xl border border-white/5">
                        <div class="flex justify-between text-slate-300">
                            <span>High (8kHz)</span>
                            <span id="high-val" class="text-cyan-300 font-mono">0.0 dB</span>
                        </div>
                        <input type="range" id="high-range" min="-15" max="15" step="0.5" value="0" class="w-full accent-cyan-400">
                    </div>
                </div>

                <!-- Spectrum Canvas -->
                <div class="bg-black/50 p-2 rounded-2xl border border-white/5 space-y-1">
                    <div class="flex justify-between text-[10px] text-slate-400 uppercase tracking-wider px-1">
                        <span>Real-Time Spectrum Analyzer</span>
                        <span class="text-cyan-400 font-mono">44.1 kHz HD</span>
                    </div>
                    <canvas id="spectrumCanvas" class="w-full h-10 rounded-lg bg-black/80 block"></canvas>
                </div>

                <!-- Export -->
                <button id="export-wav-btn" class="w-full py-2.5 rounded-xl glass-button text-cyan-200 font-medium flex items-center justify-center space-x-2 bg-cyan-950/40 border-cyan-500/30">
                    <i data-lucide="download" class="w-4 h-4 text-cyan-400"></i>
                    <span>Export 96kHz / 44.1kHz WAV-HD</span>
                </button>
            </div>
        </div>

        <!-- 2. SENTIENT AI CORE TERMINAL ("Solaris AI") -->
        <div id="win-ai" class="os-window glass-panel w-[92%] sm:w-[480px] top-16 right-6 sm:right-16 max-h-[80vh] z-30">
            <div class="window-header flex items-center justify-between px-4 py-3 border-b border-cyan-500/20 bg-black/40">
                <div class="flex items-center space-x-2">
                    <div class="w-2.5 h-2.5 rounded-full bg-cyan-400 ai-glow"></div>
                    <span class="font-cinzel font-semibold text-xs text-cyan-200 tracking-wider">Solaris AI Core Terminal</span>
                </div>
                <div class="flex items-center space-x-1.5">
                    <button onclick="minimizeWindow('win-ai')" class="p-1.5 rounded-lg text-slate-400 hover:text-white glass-button"><i data-lucide="minus" class="w-3.5 h-3.5"></i></button>
                    <button onclick="closeWindow('win-ai')" class="p-1.5 rounded-lg text-slate-400 hover:text-red-400 glass-button"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
                </div>
            </div>
            <div class="p-4 flex flex-col space-y-3 text-xs h-[360px]">
                <div id="chat-messages" class="flex-1 overflow-y-auto space-y-2.5 pr-1 font-mono text-[11px]">
                    <div class="p-2.5 rounded-2xl bg-cyan-950/40 border border-cyan-500/20 text-cyan-200">
                        <span class="text-amber-400 font-bold">SOLARIS v9.4:</span> Greetings, Sovereign. Solar resonance fields are stable. How shall we optimize the quantum core today?
                    </div>
                </div>
                <div class="flex space-x-2 pt-1">
                    <input type="text" id="chat-input" placeholder="Ask Solaris AI or type command (/status, /sing, /boost)..." class="flex-1 px-3 py-2.5 rounded-xl bg-black/50 border border-cyan-500/30 text-slate-100 focus:outline-none focus:border-cyan-400 font-mono text-xs">
                    <button id="chat-send-btn" class="glass-button px-4 py-2.5 rounded-xl text-cyan-300 font-medium flex items-center justify-center bg-cyan-950/60 border-cyan-500/40">
                        <i data-lucide="send" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- 3. QUANTUM SYSTEM MONITOR WINDOW -->
        <div id="win-monitor" class="os-window glass-panel w-[90%] sm:w-[380px] top-64 left-1/4 max-h-[75vh] z-30 minimized">
            <div class="window-header flex items-center justify-between px-4 py-3 border-b border-cyan-500/20 bg-black/40">
                <div class="flex items-center space-x-2">
                    <i data-lucide="activity" class="w-4 h-4 text-emerald-400"></i>
                    <span class="font-cinzel font-semibold text-xs text-cyan-200 tracking-wider">Quantum System Monitor</span>
                </div>
                <div class="flex items-center space-x-1.5">
                    <button onclick="minimizeWindow('win-monitor')" class="p-1.5 rounded-lg text-slate-400 hover:text-white glass-button"><i data-lucide="minus" class="w-3.5 h-3.5"></i></button>
                    <button onclick="closeWindow('win-monitor')" class="p-1.5 rounded-lg text-slate-400 hover:text-red-400 glass-button"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
                </div>
            </div>
            <div class="p-4 space-y-3 text-xs font-mono">
                <div class="space-y-1 bg-black/40 p-3 rounded-2xl border border-white/5">
                    <div class="flex justify-between text-slate-300">
                        <span>Neural Core Load</span>
                        <span id="cpu-load-val" class="text-emerald-400">18.4%</span>
                    </div>
                    <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
                        <div id="cpu-bar" class="h-full bg-gradient-to-r from-cyan-400 to-emerald-400 transition-all duration-300" style="width: 184%;"></div>
                    </div>
                </div>

                <div class="space-y-1 bg-black/40 p-3 rounded-2xl border border-white/5">
                    <div class="flex justify-between text-slate-300">
                        <span>Resonance RAM Allocation</span>
                        <span class="text-cyan-400">4.2 / 16.0 GB</span>
                    </div>
                    <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
                        <div class="h-full bg-cyan-400" style="width: 26%;"></div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <div class="bg-black/40 p-3 rounded-2xl border border-white/5 text-center">
                        <div class="text-[10px] text-slate-400 uppercase">Core Temp</div>
                        <div class="text-base text-amber-400 font-bold mt-1">36.8°C</div>
                    </div>
                    <div class="bg-black/40 p-3 rounded-2xl border border-white/5 text-center">
                        <div class="text-[10px] text-slate-400 uppercase">Sync Stability</div>
                        <div class="text-base text-cyan-400 font-bold mt-1">99.98%</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. FILE EXPLORER WINDOW -->
        <div id="win-files" class="os-window glass-panel w-[90%] sm:w-[420px] top-48 right-1/4 max-h-[75vh] z-30 minimized">
            <div class="window-header flex items-center justify-between px-4 py-3 border-b border-cyan-500/20 bg-black/40">
                <div class="flex items-center space-x-2">
                    <i data-lucide="folder" class="w-4 h-4 text-amber-400"></i>
                    <span class="font-cinzel font-semibold text-xs text-cyan-200 tracking-wider">Sovereign File Vault</span>
                </div>
                <div class="flex items-center space-x-1.5">
                    <button onclick="minimizeWindow('win-files')" class="p-1.5 rounded-lg text-slate-400 hover:text-white glass-button"><i data-lucide="minus" class="w-3.5 h-3.5"></i></button>
                    <button onclick="closeWindow('win-files')" class="p-1.5 rounded-lg text-slate-400 hover:text-red-400 glass-button"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
                </div>
            </div>
            <div class="p-4 space-y-2 text-xs">
                <div class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold mb-1">Available Audio Assets</div>
                <div class="space-y-1.5">
                    <div class="file-item flex items-center justify-between p-2.5 rounded-xl bg-black/40 border border-white/5 hover:border-cyan-500/40 cursor-pointer transition-all" onclick="loadDemoTrack('synth')">
                        <div class="flex items-center space-x-2.5">
                            <i data-lucide="music" class="w-4 h-4 text-cyan-400"></i>
                            <div>
                                <div class="font-medium text-slate-200">Sovereign_Alpha_Drone.wav</div>
                                <div class="text-[10px] text-slate-400 font-mono">Synthesized Oscillator Stream</div>
                            </div>
                        </div>
                        <span class="text-[10px] text-cyan-300 font-mono">Load</span>
                    </div>
                    <div class="file-item flex items-center justify-between p-2.5 rounded-xl bg-black/40 border border-white/5 hover:border-cyan-500/40 cursor-pointer transition-all" onclick="triggerFileUpload()">
                        <div class="flex items-center space-x-2.5">
                            <i data-lucide="upload-cloud" class="w-4 h-4 text-amber-400"></i>
                            <div>
                                <div class="font-medium text-slate-200">Import Local MP3 / WAV</div>
                                <div class="text-[10px] text-slate-400 font-mono">Select from device storage</div>
                            </div>
                        </div>
                        <span class="text-[10px] text-amber-300 font-mono">Browse</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- BOTTOM TASKBAR / DOCK -->
    <div class="relative z-40 pb-3 pt-2 px-4 flex justify-center">
        <div class="glass-panel px-4 py-2.5 rounded-3xl flex items-center space-x-3 shadow-2xl border border-cyan-500/30">
            <button onclick="toggleWindow('win-eq')" title="Sovereign EQ" class="dock-icon p-3 rounded-2xl glass-button text-cyan-300 hover:scale-110 transition-all relative group">
                <i data-lucide="disc" class="w-6 h-6"></i>
                <span class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded bg-black/90 text-[10px] text-slate-200 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none font-mono whitespace-nowrap">AIM EQ</span>
            </button>
            <button onclick="toggleWindow('win-ai')" title="Solaris AI Terminal" class="dock-icon p-3 rounded-2xl glass-button text-amber-300 hover:scale-110 transition-all relative group">
                <i data-lucide="cpu" class="w-6 h-6"></i>
                <span class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded bg-black/90 text-[10px] text-slate-200 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none font-mono whitespace-nowrap">Solaris AI</span>
            </button>
            <button onclick="toggleWindow('win-monitor')" title="Quantum Monitor" class="dock-icon p-3 rounded-2xl glass-button text-emerald-300 hover:scale-110 transition-all relative group">
                <i data-lucide="activity" class="w-6 h-6"></i>
                <span class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded bg-black/90 text-[10px] text-slate-200 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none font-mono whitespace-nowrap">Monitor</span>
            </button>
            <button onclick="toggleWindow('win-files')" title="File Vault" class="dock-icon p-3 rounded-2xl glass-button text-blue-300 hover:scale-110 transition-all relative group">
                <i data-lucide="folder" class="w-6 h-6"></i>
                <span class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded bg-black/90 text-[10px] text-slate-200 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none font-mono whitespace-nowrap">Vault</span>
            </button>
            <div class="w-px h-6 bg-cyan-500/30 mx-1"></div>
