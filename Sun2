            updateDrive(amount) {
                if (!this.filters.drive || !this.ctx) return;
                const k = amount;
                const n = 44100;
                const curve = new Float32Array(n);
                const deg = Math.PI / 180;
                for (let i = 0; i < n; ++i) {
                    const x = (i * 2) / n - 1;
                    curve[i] = ((3 + k) * x * 20 * deg) / (Math.PI + k * Math.abs(x));
                }
                this.filters.drive.curve = curve;
            }

            update() {
                if (!this.analyser || !this.isPlaying) {
                    this.metrics.bass *= 0.9;
                    this.metrics.mids *= 0.9;
                    this.metrics.treble *= 0.9;
                    return;
                }
                const data = new Uint8Array(this.analyser.frequencyBinCount);
                this.analyser.getByteFrequencyData(data);
                
                this.metrics.bass = data.slice(0, 4).reduce((a,b)=>a+b,0) / (4 * 255);
                this.metrics.mids = data.slice(4, 20).reduce((a,b)=>a+b,0) / (16 * 255);
                this.metrics.treble = data.slice(20, 45).reduce((a,b)=>a+b,0) / (25 * 255);
            }

