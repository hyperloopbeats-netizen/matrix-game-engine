        window.addEventListener('mousemove', (e) => {
            targetMouseX = e.clientX * window.devicePixelRatio;
            targetMouseY = (window.innerHeight - e.clientY) * window.devicePixelRatio;
        });

        window.addEventListener('touchmove', (e) => {
            if (e.touches.length > 0) {
                targetMouseX = e.touches[0].clientX * window.devicePixelRatio;
                targetMouseY = (window.innerHeight - e.touches[0].clientY) * window.devicePixelRatio;
            }
        }, { passive: true });

        // Spectrum Visualizer
        const spectrumCanvas = document.getElementById('spectrumCanvas');
        const sCtx = spectrumCanvas.getContext('2d');

        function drawSpectrum() {
            requestAnimationFrame(drawSpectrum);
            if (spectrumCanvas.width !== spectrumCanvas.clientWidth * window.devicePixelRatio) {
                spectrumCanvas.width = spectrumCanvas.clientWidth * window.devicePixelRatio;
                spectrumCanvas.height = spectrumCanvas.clientHeight * window.devicePixelRatio;
            }

            sCtx.clearRect(0, 0, spectrumCanvas.width, spectrumCanvas.height);
            if (!audioEngine.analyser || !audioEngine.isPlaying) {
                sCtx.fillStyle = 'rgba(186, 230, 253, 0.2)';
                sCtx.font = '10px Inter, sans-serif';
                sCtx.textAlign = 'center';
                sCtx.fillText('Load Track or Demo Synth for Live Spectrum', spectrumCanvas.width * 0.5, spectrumCanvas.height * 0.5 + 3);
                return;
            }

            const bufferLength = audioEngine.analyser.frequencyBinCount;
            const dataArray = new Uint8Array(bufferLength);
            audioEngine.analyser.getByteFrequencyData(dataArray);

            const barWidth = (spectrumCanvas.width / bufferLength) * 2.2;
            let x = 0;
            for (let i = 0; i < bufferLength; i++) {
                const barHeight = (dataArray[i] / 255) * spectrumCanvas.height;
                const grad = sCtx.createLinearGradient(0, spectrumCanvas.height, 0, 0);
                grad.addColorStop(0, 'rgba(56, 189, 248, 0.4)');
                grad.addColorStop(1, 'rgba(251, 191, 36, 0.9)');
                sCtx.fillStyle = grad;
                sCtx.fillRect(x, spectrumCanvas.height - barHeight, barWidth - 1, barHeight);
                x += barWidth + 1;
            }
        }
        drawSpectrum();

        // Render Loop
        let startTime = performance.now();
        function render(now) {
            audioEngine.update();
            const time = (now - startTime) * 0.001;

            mouseX += (targetMouseX - mouseX) * 0.1;
            mouseY += (targetMouseY - mouseY) * 0.1;

            gl.uniform2f(uLocs.res, canvas.width, canvas.height);
            gl.uniform1f(uLocs.time, time);
            gl.uniform1f(uLocs.bass, audioEngine.metrics.bass);
            gl.uniform1f(uLocs.mids, audioEngine.metrics.mids);
            gl.uniform1f(uLocs.treble, audioEngine.metrics.treble);
            gl.uniform2f(uLocs.mouse, mouseX, mouseY);
            gl.uniform1f(uLocs.drive, parseFloat(document.getElementById('drive-range').value));
            gl.uniform1f(uLocs.mood, aiMood);

            gl.drawArrays(gl.TRIANGLES, 0, 6);
            requestAnimationFrame(render);
        }
        requestAnimationFrame(render);

        // UI Event Listeners
        function triggerFileUpload() {
            document.getElementById('audioFileInput').click();
        }

        document.getElementById('upload-btn').addEventListener('click', triggerFileUpload);
        document.getElementById('audioFileInput').addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (evt) => {
                audioEngine.loadAudioBuffer(evt.target.result, file.name);
            };
            reader.readAsArrayBuffer(file);
        });

        // Drag & Drop onto canvas
        const canvasContainer = document.getElementById('canvas-container');
        const dropOverlay = document.getElementById('drop-overlay');

        ['dragenter', 'dragover'].forEach(eventName => {
            canvasContainer.addEventListener(eventName, (e) => {
                e.preventDefault(); e.stopPropagation();
                dropOverlay.classList.remove('opacity-0', 'pointer-events-none');
                dropOverlay.classList.add('opacity-100');
            }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            canvasContainer.addEventListener(eventName, (e) => {
                e.preventDefault(); e.stopPropagation();
                dropOverlay.classList.remove('opacity-100');
                dropOverlay.classList.add('opacity-0', 'pointer-events-none');
            }, false);
        });

        canvasContainer.addEventListener('drop', (e) => {
            const file = e.dataTransfer.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (evt) => audioEngine.loadAudioBuffer(evt.target.result, file.name);
                reader.readAsArrayBuffer(file);
            }
        });

        document.getElementById('demo-synth-btn').addEventListener('click', () => audioEngine.startSynth());
        document.getElementById('export-wav-btn').addEventListener('click', () => audioEngine.exportWavHD());

        function loadDemoTrack(type) {
            if (type === 'synth') {
                audioEngine.startSynth();
                toggleWindow('win-eq');
            }
        }

        function triggerEmergencyReset() {
            showToast('Initiating Quantum System Reboot...');
            setTimeout(() => window.location.reload(), 1000);
        }

        // Presets Logic
        const presets = {
            warm: { drive: 25, low: 4.5, mid: 1.0, high: -2.0, name: 'Warm Velvet' },
            space: { drive: 8, low: -1.0, mid: -3.0, high: 6.5, name: 'Deep Space' },
            solar: { drive: 75, low: 6.0, mid: 4.0, high: 3.5, name: 'Solar Flare' },
            cyber: { drive: 45, low: 2.0, mid: 5.5, high: 4.0, name: 'Cyberpunk Drive' }
        };

        document.querySelectorAll('.preset-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const p = presets[btn.getAttribute('data-preset')];
                if (!p) return;
                document.getElementById('drive-range').value = p.drive;
                document.getElementById('drive-val').innerText = p.drive + '%';
                audioEngine.updateDrive(p.drive);

                document.getElementById('low-range').value = p.low;
                document.getElementById('low-val').innerText = p.low.toFixed(1) + ' dB';
                if (audioEngine.filters.lowShelf) audioEngine.filters.lowShelf.gain.value = p.low;

                document.getElementById('mid-range').value = p.mid;
                document.getElementById('mid-val').innerText = p.mid.toFixed(1) + ' dB';
                if (audioEngine.filters.midPeak) audioEngine.filters.midPeak.gain.value = p.mid;

                document.getElementById('high-range').value = p.high;
                document.getElementById('high-val').innerText = p.high.toFixed(1) + ' dB';
                if (audioEngine.filters.highShelf) audioEngine.filters.highShelf.gain.value = p.high;

                showToast(`Preset: ${p.name}`);
            });
        });

        // EQ Sliders
        document.getElementById('drive-range').addEventListener('input', (e) => {
            const val = parseFloat(e.target.value);
            document.getElementById('drive-val').innerText = val + '%';
            audioEngine.updateDrive(val);
        });
        document.getElementById('low-range').addEventListener('input', (e) => {
            const val = parseFloat(e.target.value);
            document.getElementById('low-val').innerText = val.toFixed(1) + ' dB';
            if (audioEngine.filters.lowShelf) audioEngine.filters.lowShelf.gain.value = val;
        });
        document.getElementById('mid-range').addEventListener('input', (e) => {
            const val = parseFloat(e.target.value);
            document.getElementById('mid-val').innerText = val.toFixed(1) + ' dB';
            if (audioEngine.filters.midPeak) audioEngine.filters.midPeak.gain.value = val;
        });
        document.getElementById('high-range').addEventListener('input', (e) => {
            const val = parseFloat(e.target.value);
            document.getElementById('high-val').innerText = val.toFixed(1) + ' dB';
            if (audioEngine.filters.highShelf) audioEngine.filters.highShelf.gain.value = val;
        });
    </script>
</body>
</html>
