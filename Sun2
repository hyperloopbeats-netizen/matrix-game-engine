    <script id="vertexShader" type="x-shader/x-vertex">
        attribute vec2 a_position;
        varying vec2 v_uv;
        void main() {
            v_uv = (a_position + 1.0) * 0.5;
            gl_Position = vec4(a_position, 0.0, 1.0);
        }
    </script>
    <script id="fragmentShader" type="x-shader/x-fragment">
        precision mediump float;
        varying vec2 v_uv;
        uniform vec2 u_resolution;
        uniform float u_time;
        uniform float u_bass;
        uniform float u_mids;
        uniform float u_treble;
        uniform vec2 u_mouse;
        uniform float u_drive;
        uniform float u_mood;

        #define PI 3.14159265359

        vec2 complexMul(vec2 a, vec2 b) {
            return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
        }

        void main() {
            vec2 st = (gl_FragCoord.xy - 0.5 * u_resolution.xy) / min(u_resolution.x, u_resolution.y);
            
            vec2 mouseOffset = (u_mouse - 0.5 * u_resolution.xy) / min(u_resolution.x, u_resolution.y);
            st -= mouseOffset * 0.22 / (length(st - mouseOffset) + 0.45);

            float time = u_time * 0.12;
            float r = length(st);
            
            float coreGlow = 0.05 / (r + 0.022 + u_bass * 0.28);
            
            vec2 z = st;
            float accum = 0.0;
            float scale = 1.0;
            for (int i = 0; i < 5; i++) {
                float angle = atan(z.y, z.x);
                float rad = length(z);
                angle = mod(angle + PI / 3.0 + time * 0.25 + u_mood * 0.1, 2.0 * PI / 3.0) - PI / 3.0;
                z = vec2(cos(angle), sin(angle)) * rad;
                z = abs(z) - vec2(0.26, 0.13) * (1.0 + u_mids * 0.4);
                z = complexMul(z, z) - vec2(0.36 + u_drive * 0.001, 0.07);
                accum += sin(z.x * 4.5 + time) * cos(z.y * 4.5 - time) / scale;
                scale *= 1.28;
            }

            vec3 colTeal = vec3(0.01, 0.05, 0.16);
            vec3 colOrange = vec3(0.95 + u_mood * 0.05, 0.50 + u_drive * 0.002, 0.10);
            vec3 color = mix(colTeal, colOrange, clamp(abs(accum) * 1.4 + r * 0.32, 0.0, 1.0));
            
            color += vec3(1.0, 0.86, 0.50) * coreGlow * (1.0 + u_bass * 2.8);
            color += vec3(0.22, 0.65, 1.0) * u_treble * 0.38 * (1.0 - r);
            color += vec3(0.9, 0.35, 0.05) * (u_drive / 100.0) * 0.22 * (1.0 - r);

            gl_FragColor = vec4(color, 1.0);
        }
    </script>

