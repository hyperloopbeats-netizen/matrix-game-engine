<!DOCTYPE html>
<html lang="en" class="h-full select-none bg-black">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Cometic Engine — Cute Data Visual Matrix v26.3</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Three.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Three.js Postprocessing Addons -->
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&family=Orbitron:wght@600;800&family=Fira+Code:wght@400;600&display=swap');

        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden;
            background-color: #0b0f19; font-family: 'Quicksand', sans-serif; color: #f8fafc;
            user-select: none; -webkit-user-select: none; touch-action: none;
        }

        .font-orbitron { font-family: 'Orbitron', sans-serif; }
        .font-mono-code { font-family: 'Fira Code', monospace; }
        .font-quicksand { font-family: 'Quicksand', sans-serif; }

        #viewport-container {
            position: absolute; inset: 0; bottom: 65px; z-index: 10;
        }

        /* Pastel Micro-HUD Chassis */
        .micro-hud-chassis {
            position: absolute; bottom: 0; left: 0; right: 0; height: 65px;
            background: rgba(15, 23, 42, 0.94);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border-top: 2px solid rgba(244, 114, 182, 0.45);
            z-index: 50;
            display: flex; flex-direction: column; justify-content: space-between; padding: 6px 12px;
        }

        .matrix-overlay {
            position: absolute; inset: 0; bottom: 65px;
            background: rgba(11, 15, 25, 0.96);
            backdrop-filter: blur(32px);
            -webkit-backdrop-filter: blur(32px);
            z-index: 40;
            display: none; flex-direction: column; padding: 16px; overflow: hidden;
        }

        .step-card {
            background: rgba(30, 41, 59, 0.85);
            border: 1px solid rgba(244, 114, 182, 0.3);
            transition: all 0.2s ease;
        }
        .step-card.unlocked {
            border-color: rgba(244, 114, 182, 0.8);
            background: rgba(83, 29, 61, 0.35);
            box-shadow: 0 0 15px rgba(244, 114, 182, 0.25);
        }
        .step-card.active-step {
            border-color: #38bdf8;
            background: rgba(14, 116, 144, 0.4);
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.4);
        }

        .custom-scroll::-webkit-scrollbar { width: 4px; height: 4px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: rgba(244, 114, 182, 0.4); border-radius: 4px; }
    </style>
</head>
<body class="relative w-full h-full bg-[#0b0f19] overflow-hidden">

    <!-- 3D Spatial WebGL2 Viewport -->
    <div id="viewport-container">
        <canvas id="simCanvas" class="w-full h-full block touch-none cursor-pointer"></canvas>
    </div>

    <!-- Cometic Engine 10-Step Kawaii Matrix Overlay -->
    <div id="matrix-overlay" class="matrix-overlay custom-scroll space-y-3 font-quicksand">
        <div class="flex items-center justify-between pb-2 border-b border-pink-500/30">
            <div class="flex items-center space-x-2">
                <span id="matrix-status-dot" class="w-2.5 h-2.5 rounded-full bg-pink-400 animate-ping"></span>
                <span class="font-orbitron text-xs font-bold text-pink-200 tracking-wider">COMETIC ENGINE // CUTE DATA MATRIX v26.3</span>
            </div>
            <div class="flex items-center space-x-2">
                <button onclick="engine.runFullEvolutionSequence()" class="bg-pink-500/30 border border-pink-400 text-pink-200 px-2.5 py-1 rounded text-[9px] font-bold hover:bg-pink-500/50 transition-all">KAWAII OVERDRIVE [1-10]</button>
                <button onclick="toggleMatrixOverlay(false)" class="text-slate-400 hover:text-white px-2 py-1 rounded bg-slate-900 border border-slate-700 text-[9px] font-mono">CLOSE [X]</button>
            </div>
        </div>

        <!-- 10-Step Interactive Kawaii Grid -->
        <div class="grid grid-cols-5 gap-2 font-mono text-[9px]">
            <div id="step-card-1" class="step-card p-2 rounded-xl space-y-1 cursor-pointer" onclick="engine.activateStep(1)">
                <div class="text-pink-300 font-bold flex justify-between"><span>01. SOFT CTX</span><span id="s1-status">🔒</span></div>
                <div class="text-[8px] text-slate-300 font-quicksand">Pastel WebGL2 Context Boot</div>
            </div>
            <div id="step-card-2" class="step-card p-2 rounded-xl space-y-1 cursor-pointer" onclick="engine.activateStep(2)">
                <div class="text-pink-300 font-bold flex justify-between"><span>02. GEL SHADER</span><span id="s2-status">🔒</span></div>
