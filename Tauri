export class B12AutonomicMemoryUnit {
    private telemetryRingBuffer: { timestamp: number; fps: number; health: number; x: number; y: number; z: number }[] = [];
    private bufferCapacity: number = 120; // 2 seconds of 60Hz memory
    private healEventsCount: number = 0;
    private generation: number = 1;
    private stationarySeconds: number = 0;
    private wallRunAccumulator: number = 0;

    public genome: EvolutionGenome = {
        aiSpawnIntervalSec: 15.0,
        pilotMaxSpeed: 13.0,
        wallRunGravityScale: 0.1,
        fogDensity: 0.015,
        renderPixelRatio: Math.min(window.devicePixelRatio || 1, 2)
    };

    constructor() {
        console.log("[AutonomicMemory] Initializing zero-allocation telemetry memory ring.");
    }

    public recordSnapshot(fps: number, health: number, pos: THREE.Vector3, isWallRunning: boolean): void {
        if (isWallRunning) this.wallRunAccumulator += 0.016;

        this.telemetryRingBuffer.push({
            timestamp: performance.now(),
            fps,
            health,
            x: pos.x,
            y: pos.y,
            z: pos.z
        });

        if (this.telemetryRingBuffer.length > this.bufferCapacity) {
            this.telemetryRingBuffer.shift();
        }
    }

    public diagnoseAndHeal(orchestrator: any): string[] {
        const patchesApplied: string[] = [];
        const latest = this.telemetryRingBuffer[this.telemetryRingBuffer.length - 1];
        if (!latest) return patchesApplied;

        // 1. Self-Heal: Physics Coordinate Anomaly / Out of Bounds
        if (Number.isNaN(latest.x) || latest.y < -20 || Math.abs(latest.z) > 400) {
            console.warn("[Self-Heal] Coordinate anomaly detected in memory state. Reverting to safe anchor.");
            if (orchestrator.pilotSystem) {
                const pState = orchestrator.pilotSystem.getState();
                pState.position.set(0, 2, 18);
                pState.velocity.set(0, 0, 0);
            }
            patchesApplied.push("PHYSICS_COORDINATE_RECOVERY");
            this.healEventsCount++;
        }

        // 2. Self-Heal: Low FPS Thermal / GPU Throttling
        if (latest.fps < 38) {
            this.genome.renderPixelRatio = Math.max(0.7, this.genome.renderPixelRatio - 0.2);
            this.genome.fogDensity = Math.min(0.04, this.genome.fogDensity + 0.005);
            if (orchestrator.renderer) orchestrator.renderer.setPixelRatio(this.genome.renderPixelRatio);
            if (orchestrator.scene?.fog) orchestrator.scene.fog.density = this.genome.fogDensity;
            patchesApplied.push("GPU_LOAD_SHEDDING");
            this.healEventsCount++;
        }

        // 3. Evolutionary Mutation Check
        if (this.wallRunAccumulator >= 7.0) {
            this.generation++;
            this.genome.pilotMaxSpeed = Math.min(18.0, this.genome.pilotMaxSpeed + 1.0);
            this.genome.aiSpawnIntervalSec = Math.max(8.0, this.genome.aiSpawnIntervalSec - 1.5);
            this.wallRunAccumulator = 0;
            patchesApplied.push(`EVOLUTION_GEN_${this.generation}_SPEED_BOOST`);
        }

        return patchesApplied;
    }

    public getStats() {
        return { heals: this.healEventsCount, gen: this.generation, genome: this.genome };
    }
}

