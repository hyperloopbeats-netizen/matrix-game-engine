export class ProductionLevelDesignSystem {
    private obstacles = new THREE.Group();

    constructor(private scene: THREE.Scene) {
        // Ground Arena (Typhon Jungle Clearing)
        const ground = new THREE.Mesh(
            new THREE.PlaneGeometry(300, 300),
            new THREE.MeshStandardMaterial({ color: 0x14181f, roughness: 0.8 })
        );
        ground.rotation.x = -Math.PI / 2;
        ground.receiveShadow = true;
        this.scene.add(ground);

        // Wall-Run Conduits
        const wallMat = new THREE.MeshStandardMaterial({ color: 0x222834, roughness: 0.5 });
        const wallGeo = new THREE.BoxGeometry(2, 12, 35);
        
        const leftWall = new THREE.Mesh(wallGeo, wallMat);
        leftWall.position.set(-7, 6, -10);
        this.obstacles.add(leftWall);
        this.scene.add(leftWall);

        const rightWall = new THREE.Mesh(wallGeo, wallMat);
        rightWall.position.set(7, 6, -10);
        this.obstacles.add(rightWall);
        this.scene.add(rightWall);
    }

    public getObstacles(): THREE.Group { return this.obstacles; }
}

export class ProductionPilotPhysics {
    private state: PilotState;
    private raycaster = new THREE.Raycaster();
    private wallNormal = new THREE.Vector3();
    private wasJumpPressed = false;

    constructor(initialPos: THREE.Vector3) {
        this.state = {
            position: initialPos.clone(),
            velocity: new THREE.Vector3(0, 0, 0),
            isGrounded: true,
            isWallRunning: false,
            isSliding: false,
            airJumpsRemaining: 1,
            titanMeterPercent: 0.0
        };
    }

    public update(dt: number, input: PilotInputState, obstacleGroup: THREE.Group, maxSpeed: number): PilotState {
        // Sliding
        if (input.slide && this.state.isGrounded && !this.state.isSliding) {
            this.state.isSliding = true;
            this.state.velocity.multiplyScalar(1.5);
            this.state.titanMeterPercent = Math.min(100, this.state.titanMeterPercent + 2.0);
        } else if (!input.slide && this.state.isGrounded) {
            this.state.isSliding = false;
        }

        // Wall Run Check
        let detectedWall = false;
        const rightDir = new THREE.Vector3(1, 0, 0);
        this.raycaster.set(this.state.position, rightDir);
        let hits = this.raycaster.intersectObjects(obstacleGroup.children, true);

        if (hits.length > 0 && hits[0].distance < 1.3 && !this.state.isGrounded) {
            detectedWall = true;
            this.wallNormal.copy(hits[0].face?.normal || new THREE.Vector3(-1, 0, 0));
        }

        if (detectedWall && input.wallRun) {
            this.state.isWallRunning = true;
            this.state.velocity.y = Math.max(this.state.velocity.y, -1.2);
            this.state.titanMeterPercent = Math.min(100, this.state.titanMeterPercent + 0.1);
        } else {
            this.state.isWallRunning = false;
        }

        // Jumps
        if (input.jump && !this.wasJumpPressed) {
            if (this.state.isGrounded) {
                this.state.velocity.y = 12.0;
                this.state.isGrounded = false;
            } else if (this.state.isWallRunning) {
                this.state.velocity.addScaledVector(this.wallNormal, 15.0);
                this.state.velocity.y = 11.0;
                this.state.isWallRunning = false;
            } else if (this.state.airJumpsRemaining > 0) {
                this.state.velocity.y = 10.0;
                this.state.airJumpsRemaining--;
            }
        }
        this.wasJumpPressed = input.jump;

        // Gravity & Integration
        if (this.state.isWallRunning) {
            this.state.velocity.y -= 30.0 * 0.1 * dt;
        } else if (!this.state.isGrounded) {
            this.state.velocity.y -= 28.0 * dt;
        }

        if (this.state.isGrounded && !this.state.isSliding) {
            this.state.velocity.x -= this.state.velocity.x * 12.0 * dt;
            this.state.velocity.z -= this.state.velocity.z * 12.0 * dt;
        }

        const targetVx = input.moveX * maxSpeed;
        this.state.velocity.x += (targetVx - this.state.velocity.x) * 40.0 * dt;
        this.state.position.addScaledVector(this.state.velocity, dt);

        if (this.state.position.y <= 0) {
            this.state.position.y = 0;
            this.state.velocity.y = 0;
            this.state.isGrounded = true;
            this.state.airJumpsRemaining = 1;
            this.state.isWallRunning = false;
        }

        return this.state;
    }

    public getState(): PilotState { return this.state; }
}

