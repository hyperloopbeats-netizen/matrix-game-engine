        const input = document.getElementById('terminal-input');
        const cmd = input.value.trim().toLowerCase();
        const output = document.getElementById('terminal-output');
        
        output.innerHTML += `<div>nexus@os:~$ ${input.value}</div>`;

        if (cmd === 'help') {
          output.innerHTML += `<div>Available commands: <span class="text-cyan-300">sentient</span>, <span class="text-cyan-300">game</span>, <span class="text-cyan-300">forge</span>, <span class="text-cyan-300">clear</span>, <span class="text-cyan-300">about</span></div>`;
        } else if (cmd === 'sentient') {
          openWindow('window-sentient');
          output.innerHTML += `<div>Launching Sentient Core AI...</div>`;
        } else if (cmd === 'game') {
          openWindow('window-gaming');
          output.innerHTML += `<div>Launching Arcade Hub...</div>`;
        } else if (cmd === 'forge') {
          openWindow('window-codeforge');
          output.innerHTML += `<div>Launching Code Forge IDE...</div>`;
        } else if (cmd === 'clear') {
          output.innerHTML = '';
        } else if (cmd === 'about') {
          output.innerHTML += `<div>AIM OS Nexus v5.0 Sentient Edition • Autonomous Code-to-Game Operating System</div>`;
        } else {
          output.innerHTML += `<div class="text-rose-400">Command not recognized: ${cmd}. Type 'help'.</div>`;
        }

        input.value = '';
        const body = document.getElementById('terminal-body');
        body.scrollTop = body.scrollHeight;
      }
    }
  </script>
</body>
</html>
