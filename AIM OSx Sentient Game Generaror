          const x = this.engine.width/2 + Math.cos(this.angle) * 140;
          const y = this.engine.height/2 + Math.sin(this.angle) * 140;
          ctx.fillStyle = '#38bdf8'; ctx.beginPath(); ctx.arc(x, y, 12, 0, Math.PI*2); ctx.fill();
          ctx.fillStyle = '#ffffff'; ctx.font = '12px JetBrains Mono';
          ctx.fillText('GRAVITY ORBITER • SCORE: ' + Math.floor(this.score), 20, 30);
        }
      }
    };

    class ArcadeEngine {
      constructor(canvasId) {
        this.canvas = document.getElementById(canvasId);
        this.ctx = this.canvas.getContext('2d');
        this.width = this.canvas.width;
        this.height = this.canvas.height;
        this.isRunning = false;
        this.game = null;
        this.input = { keys: {}, joystickLeft: { x: 0, y: 0 }, action1: false };
        this.lastTime = 0;

        window.addEventListener('keydown', e => this.input.keys[e.code] = true);
        window.addEventListener('keyup', e => this.input.keys[e.code] = false);
        this.initTouchControls();
      }

      initTouchControls() {
        const base = document.getElementById('arcade-joystick-base');
        const knob = base.querySelector('.joystick-knob');
        const btn = document.getElementById('arcade-btn-action');
        let touchId = null, cx = 0, cy = 0;

        base.addEventListener('touchstart', e => {
          e.preventDefault();
          touchId = e.changedTouches[0].identifier;
          const rect = base.getBoundingClientRect();
          cx = rect.left + rect.width / 2; cy = rect.top + rect.height / 2;
        });
        window.addEventListener('touchmove', e => {
          if (touchId === null) return;
          for(let i=0; i<e.changedTouches.length; i++) {
            if(e.changedTouches[i].identifier === touchId) {
              const dx = e.changedTouches[i].clientX - cx;
              const dy = e.changedTouches[i].clientY - cy;
              const dist = Math.hypot(dx, dy);
              const angle = Math.atan2(dy, dx);
              const capped = Math.min(dist, 35);
              knob.style.transform = `translate(${Math.cos(angle)*capped}px, ${Math.sin(angle)*capped}px)`;
              this.input.joystickLeft.x = Math.cos(angle) * (capped/35);
              this.input.joystickLeft.y = Math.sin(angle) * (capped/35);
            }
          }
        });
        const endTouch = e => {
          for(let i=0; i<e.changedTouches.length; i++) {
            if(e.changedTouches[i].identifier === touchId) {
              touchId = null; this.input.joystickLeft.x = 0; this.input.joystickLeft.y = 0;
              knob.style.transform = 'translate(0px, 0px)';
            }
          }
        };
        window.addEventListener('touchend', endTouch);
        btn.addEventListener('touchstart', e => { e.preventDefault(); this.input.action1 = true; });
      }

      loadGame(gameKey) {
        const GameClass = ARCADE_GAMES[gameKey] || ARCADE_GAMES.cyber_pong;
        this.game = new GameClass(this);
      }

      start() {
        if (this.isRunning) return;
        this.isRunning = true;
        this.lastTime = performance.now();
        const loop = (t) => {
          if (!this.isRunning) return;
          const dt = (t - this.lastTime) / 1000;
          this.lastTime = t;
          if (this.game) {
            if (this.game.update) this.game.update(dt, this.input);
            if (this.game.render) this.game.render(this.ctx);
          }
          requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);
      }
    }

