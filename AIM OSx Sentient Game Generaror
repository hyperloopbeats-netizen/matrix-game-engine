    // --- Arcade Hub Engine ---
    let arcadeRuntime = null;
    const ARCADE_GAMES = {
      cyber_pong: class {
        constructor(engine) { this.engine = engine; this.reset(); }
        reset() {
          this.bx = this.engine.width / 2; this.by = this.engine.height / 2;
