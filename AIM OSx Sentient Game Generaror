          ctx.beginPath(); ctx.moveTo(this.engine.width/2, 0); ctx.lineTo(this.engine.width/2, this.engine.height); ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillStyle = '#38bdf8'; ctx.fillRect(20, this.p1y, 12, 60);
          ctx.fillStyle = '#f43f5e'; ctx.fillRect(this.engine.width - 32, this.p2y, 12, 60);
          ctx.fillStyle = '#ffffff'; ctx.beginPath(); ctx.arc(this.bx, this.by, 8, 0, Math.PI*2); ctx.fill();
        }
      },

