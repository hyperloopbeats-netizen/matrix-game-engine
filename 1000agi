  <script>
    // --- 1. BINARY SPLIT CORE, DUAL-CORE GOVERNOR & AI MEDIC ---
    class AIMedicSelfHealingBridge {
      constructor() {
        this.incidentCount = 0;
        this.activePatches = new Set();
      }
      inspectAndHeal(codeSnippet) {
        let logs = [];
        let healed = codeSnippet;
        if (codeSnippet.includes("while(true)") || codeSnippet.includes("while (true)")) {
          this.incidentCount++;
          logs.push(`AI Medic: Infinite loop detected. Hard frame boundary injected.`);
          healed = codeSnippet.replace(/while\s*\(true\)/g, "while(running && frameCount < 10000)");
        }
        return { healed, logs };
      }
    }

    class DualCoreGovernor {
      constructor() {
        this.genesisLoad = 0.45;
        this.executionerLoad = 0.52;
        this.medic = new AIMedicSelfHealingBridge();
      }
      processHemispheres(taskName, rawCode) {
        // Hemisphere A: Genesis Expansion
        this.genesisLoad = Math.min(0.95, this.genesisLoad + 0.05);
        let genesisOutput = `// [HEMISPHERE A: GENESIS EXPANSION - ${taskName}]\n` + rawCode;

        // Hemisphere B: Executioner Hardening & AI Medic Verification
        this.executionerLoad = Math.min(0.95, this.executionerLoad + 0.05);
        let { healed, logs } = this.medic.inspectAndHeal(genesisOutput);

        return { hardenedCode: healed, logs, incidentCount: this.medic.incidentCount };
      }
    }

    // --- 2. WEB WORKER BACKGROUND TIMING CLOCK ---
    const workerScript = `
      let timerId = null;
      let tempo = 120;
      let step = 0;
      function startClock(bpm) {
        tempo = bpm;
        const intervalMs = (60 / tempo) * 500;
        if (timerId) clearInterval(timerId);
        timerId = setInterval(() => {
          postMessage({ type: 'TICK', step: step, tempo: tempo });
          step = (step + 1) % 64;
        }, intervalMs);
      }
      onmessage = function(e) {
        const { type, tempo: newTempo } = e.data;
        if (type === 'START' || type === 'UPDATE_TEMPO') {
          if (newTempo) tempo = newTempo;
          startClock(tempo);
        } else if (type === 'STOP') {
          if (timerId) clearInterval(timerId);
          timerId = null;
          step = 0;
        }
      };
    `;
    const workerBlob = new Blob([workerScript], { type: 'application/javascript' });
    const orionAudioWorker = new Worker(URL.createObjectURL(workerBlob));

    // --- 3. ORCHESTRAL CONDUCTOR & DSP CLASS ---
    class OrchestralConductor {
      constructor(audioContext) {
        this.ctx = audioContext;
        this.masterGain = this.ctx.createGain();
        this.masterGain.gain.setValueAtTime(0.3, this.ctx.currentTime);

        this.analyser = this.ctx.createAnalyser();
        this.analyser.fftSize = 64;
        this.dataArray = new Uint8Array(this.analyser.frequencyBinCount);

        this.initFXChain();

        this.busses = {
          vocal: this.createBus(),
          rhythm: this.createBus(),
          harmony: this.createBus(),
          symphony: this.createBus()
        };

        this.tempo = 120;
        this.transpositionSemitones = 0;
        this.tension = 0.0;
        this.isPlaying = false;
        this.chordStep = 0;

        this.baseChordProgression = [
          [220.00, 261.63, 329.63, 440.00], // Am
          [174.61, 220.00, 261.63, 349.23], // F
          [130.81, 164.81, 196.00, 261.63], // C
          [196.00, 246.94, 293.66, 392.00]  // G
        ];

        orionAudioWorker.onmessage = (e) => {
          if (e.data.type === 'TICK' && this.isPlaying) {
            this.onWorkerTick(e.data.step);
          }
        };
      }

      initFXChain() {
        this.fxFilter = this.ctx.createBiquadFilter();
        this.fxFilter.type = 'lowpass';
        this.fxFilter.frequency.setValueAtTime(5000, this.ctx.currentTime);
        this.fxFilter.Q.setValueAtTime(2.0, this.ctx.currentTime);

        this.fxDrive = this.ctx.createWaveShaper();
        this.fxDrive.curve = this.makeDistortionCurve(0);

        this.masterGain.connect(this.fxFilter);
        this.fxFilter.connect(this.fxDrive);
        this.fxDrive.connect(this.analyser);
        this.analyser.connect(this.ctx.destination);
      }

      makeDistortionCurve(amount) {
        const k = typeof amount === 'number' ? amount : 50;
        const n_samples = 44100;
        const curve = new Float32Array(n_samples);
        const deg = Math.PI / 180;
        for (let i = 0; i < n_samples; ++i) {
          const x = (i * 2) / n_samples - 1;
          curve[i] = ((3 + k) * x * 20 * deg) / (Math.PI + k * Math.abs(x));
        }
        return curve;
      }

      setFilterCutoff(freqHz) {
        if (!this.fxFilter) return;
        this.fxFilter.frequency.setTargetAtTime(Math.max(100, Math.min(20000, freqHz)), this.ctx.currentTime, 0.05);
      }

      setDriveAmount(amount) {
        if (!this.fxDrive) return;
        this.fxDrive.curve = this.makeDistortionCurve(amount);
      }

      createBus() {
        const gain = this.ctx.createGain();
        gain.gain.setValueAtTime(0.7, this.ctx.currentTime);
        gain.connect(this.masterGain);
        return gain;
      }

      getAudioEnergy() {
        if (!this.isPlaying) return 0.0;
        this.analyser.getByteFrequencyData(this.dataArray);
        let sum = 0;
        for (let i = 0; i < this.dataArray.length; i++) sum += this.dataArray[i];
        return (sum / this.dataArray.length) / 255.0;
      }

      setTempo(newBpm) {
        this.tempo = Math.max(60, Math.min(240, newBpm));
        if (this.isPlaying) {
          orionAudioWorker.postMessage({ type: 'UPDATE_TEMPO', tempo: this.tempo });
        }
      }

      transpose(semitones) {
        this.transpositionSemitones = Math.max(-12, Math.min(12, semitones));
      }

      setTier(tierLevel) {
        this.busses.vocal.gain.setValueAtTime(tierLevel >= 1 ? 0.8 : 0, this.ctx.currentTime);
        this.busses.rhythm.gain.setValueAtTime(tierLevel >= 2 ? 0.7 : 0, this.ctx.currentTime);
        this.busses.harmony.gain.setValueAtTime(tierLevel >= 3 ? 0.6 : 0, this.ctx.currentTime);
        this.busses.symphony.gain.setValueAtTime(tierLevel >= 4 ? 0.5 : 0, this.ctx.currentTime);
      }

      setTension(val) {
        this.tension = Math.max(0, Math.min(1, val));
      }

      forceChord(index, name, freqs) {
        this.chordStep = index;
        this.tension = 0.5;
        this.playManualChord(freqs);
      }

      playManualChord(freqs) {
        if (!this.isPlaying) return;
        const now = this.ctx.currentTime;
        const activeFreqs = freqs.map(f => f * Math.pow(2, this.transpositionSemitones / 12));
        activeFreqs.forEach((baseFreq) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(baseFreq * 2, now);
          gain.gain.setValueAtTime(0.06, now);
          gain.gain.linearRampToValueAtTime(0.001, now + 0.5);
          osc.connect(gain);
          gain.connect(this.busses.harmony);
          osc.start(now);
          osc.stop(now + 0.5);
        });
      }

      onWorkerTick(step) {
        if (!this.isPlaying) return;
        const now = this.ctx.currentTime;

        if (step % 8 === 0) {
          this.chordStep = (this.chordStep + 1) % this.baseChordProgression.length;
          this.tension = 0.2 + (this.chordStep * 0.2);
        }

        if (this.busses.rhythm.gain.value > 0) {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(150, now);
          osc.frequency.exponentialRampToValueAtTime(40, now + 0.15);
          gain.gain.setValueAtTime(0.5, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
          osc.connect(gain);
          gain.connect(this.busses.rhythm);
          osc.start(now);
          osc.stop(now + 0.15);
        }

        const multiplier = Math.pow(2, this.transpositionSemitones / 12);
        const activeChordFreqs = this.baseChordProgression[this.chordStep].map(f => f * multiplier);

        if (this.busses.harmony.gain.value > 0 || this.busses.symphony.gain.value > 0) {
          activeChordFreqs.forEach((baseFreq, idx) => {
            if (this.busses.harmony.gain.value > 0 && idx < 3) {
              const osc = this.ctx.createOscillator();
              const gain = this.ctx.createGain();
              osc.type = 'triangle';
              osc.frequency.setValueAtTime(baseFreq * 2, now);
              gain.gain.setValueAtTime(0.04, now);
              gain.gain.linearRampToValueAtTime(0.001, now + 0.3);
              osc.connect(gain);
              gain.connect(this.busses.harmony);
              osc.start(now);
              osc.stop(now + 0.3);
            }

            if (this.busses.symphony.gain.value > 0) {
              const osc = this.ctx.createOscillator();
              const gain = this.ctx.createGain();
              const filter = this.ctx.createBiquadFilter();
              osc.type = 'sawtooth';
              osc.frequency.setValueAtTime(baseFreq * (1 + this.tension * 0.02), now);
              filter.type = 'lowpass';
              filter.frequency.setValueAtTime(800 + this.tension * 1200, now);
              gain.gain.setValueAtTime(0.015, now);
              gain.gain.linearRampToValueAtTime(0.001, now + (60 / this.tempo) * 3);
              osc.connect(filter);
              filter.connect(gain);
              gain.connect(this.busses.symphony);
              osc.start(now);
              osc.stop(now + (60 / this.tempo) * 3);
            }
          });
        }
      }

      start(tier = 4) {
        if (this.isPlaying) return;
        this.isPlaying = true;
        this.chordStep = 0;
        this.setTier(tier);
        orionAudioWorker.postMessage({ type: 'START', tempo: this.tempo });
      }

      stop() {
        this.isPlaying = false;
        orionAudioWorker.postMessage({ type: 'STOP' });
      }
    }

    // --- 4. ONTOLOGICAL WORLD SPAWNER ---
    class OntologicalWorldSpawner {
      constructor(threeScene) {
        this.scene = threeScene;
        this.currentEntities = [];
      }
      clearWorld() {
        this.currentEntities.forEach(entity => this.scene.remove(entity));
        this.currentEntities = [];
      }
      spawnEnvironment(manifest) {
        this.clearWorld();
        const themeColors = {
          cyberpunk: { primary: 0x00a2ff, secondary: 0xf43f5e },
          sunset: { primary: 0xf59e0b, secondary: 0xec4899 },
          symphonic: { primary: 0x8b5cf6, secondary: 0x06b6d4 }
        };
        const colors = themeColors[manifest.theme] || themeColors.cyberpunk;
        const geometryType = manifest.entityType === 'orchestra' ? new THREE.TorusKnotGeometry(1.2, 0.35, 128, 32) : new THREE.IcosahedronGeometry(1.4, 64);
        const material = new THREE.MeshStandardMaterial({
          color: colors.primary,
          roughness: 0.1,
          metalness: 0.9,
          emissive: colors.primary,
          emissiveIntensity: 0.3
        });
        const coreEntity = new THREE.Mesh(geometryType, material);
        coreEntity.position.set(0, 0, 0);
        this.scene.add(coreEntity);
        this.currentEntities.push(coreEntity);
        return coreEntity;
      }
    }

    // --- 5. EPOCH ARCADE PHYSICS SANDBOX & COLLISION ---
    class EpochPhysicsSandbox {
      constructor(threeScene, conductor) {
        this.scene = threeScene;
        this.conductor = conductor;
        this.projectiles = [];
        this.isActive = false;
      }
      start() { this.isActive = true; }
      stop() { this.isActive = false; this.clearProjectiles(); }
      clearProjectiles() {
        this.projectiles.forEach(p => this.scene.remove(p.mesh));
        this.projectiles = [];
      }
      spawnBeatPulse() {
        if (!this.isActive) return;
        const geometry = new THREE.RingGeometry(0.5, 0.6, 32);
        const material = new THREE.MeshBasicMaterial({ color: 0x00a2ff, side: THREE.DoubleSide, transparent: true, opacity: 0.8 });
        const mesh = new THREE.Mesh(geometry, material);
        mesh.position.set(0, 0, 0);
        mesh.rotation.x = Math.PI / 2;
        this.scene.add(mesh);
        this.projectiles.push({ mesh: mesh, scale: 1.0, opacity: 0.8, speed: 0.08 });
      }
      updateFrame(time, liquidMesh) {
        if (!this.isActive) return;
        const energy = this.conductor ? this.conductor.getAudioEnergy() : 0;
        for (let i = this.projectiles.length - 1; i >= 0; i--) {
          let p = this.projectiles[i];
          p.scale += p.speed + (energy * 0.1);
          p.opacity -= 0.02;
          p.mesh.scale.set(p.scale, p.scale, p.scale);
          p.mesh.material.opacity = p.opacity;

          if (Math.abs(p.scale - 1.45) < 0.25 && liquidMesh) {
            this.applyVertexShockwave(liquidMesh, p.scale);
          }
          if (p.opacity <= 0) {
            this.scene.remove(p.mesh);
            this.projectiles.splice(i, 1);
          }
        }
      }
      applyVertexShockwave(mesh, ringRadius) {
        const posAttr = mesh.geometry.attributes.position;
        const vertex = new THREE.Vector3();
        for (let j = 0; j < posAttr.count; j++) {
          vertex.fromBufferAttribute(posAttr, j);
          const distFromOrigin = vertex.length();
          if (Math.abs(distFromOrigin - ringRadius) < 0.35) {
            const normal = vertex.clone().normalize();
            vertex.addScaledVector(normal, 0.35);
            posAttr.setXYZ(j, vertex.x, vertex.y, vertex.z);
          }
        }
        posAttr.needsUpdate = true;
        mesh.geometry.computeVertexNormals();
      }
    }

    // --- 6. INTERNAL MIRROR SWARM WITH DUAL-CORE GOVERNOR ---
    class InternalMirrorSwarm {
      constructor(conductor, spawner, liquidMesh) {
        this.conductor = conductor;
        this.spawner = spawner;
        this.liquidMesh = liquidMesh;
        this.governor = new DualCoreGovernor();
        this.activeManifest = null;
      }
      async processUserInquiry(promptText) {
        const logContainer = document.getElementById('swarm-log');
        const genesisElem = document.getElementById('hemisphere-a-load');
        const execElem = document.getElementById('hemisphere-b-load');
        const healedElem = document.getElementById('hud-healed');
        const patchesElem = document.getElementById('medic-patches-count');

        const log = (msg, color = 'text-slate-300') => {
          if (logContainer) {
            logContainer.innerHTML += `<div class="${color}">[Binary Split]: ${msg}</div>`;
            logContainer.scrollTop = logContainer.scrollHeight;
          }
        };

        log(`Running dual-core synthesis for "${promptText}"...`, 'text-cyan-400');
        await new Promise(r => setTimeout(r, 150));

        // Pass through Dual-Core Governor & AI Medic
        let sampleTaskCode = `function runLoop() { while(true) { renderFrame(); } }`;
        let { hardenedCode, logs, incidentCount } = this.governor.processHemispheres(promptText, sampleTaskCode);

        genesisElem.textContent = `${this.governor.genesisLoad.toFixed(2)} load`;
        execElem.textContent = `${this.governor.executionerLoad.toFixed(2)} load`;
        healedElem.textContent = `${incidentCount} incidents`;
        patchesElem.textContent = `${incidentCount} applied`;

        logs.forEach(l => log(l, 'text-amber-400'));

        const lower = promptText.toLowerCase();
        const tier = lower.includes('symphony') || lower.includes('orchestra') ? 4 : (lower.includes('band') ? 2 : 1);
        const theme = lower.includes('cyberpunk') ? 'cyberpunk' : (lower.includes('sunset') ? 'sunset' : 'symphonic');

        if (this.conductor.ctx.state === 'suspended') await this.conductor.ctx.resume();
        this.conductor.start(tier);
        this.conductor.setTension(tier * 0.25);

        const manifest = { theme, weather: 'rain', tier, entityType: tier >= 3 ? 'orchestra' : 'vocalist' };
        this.activeManifest = manifest;
        const newMesh = this.spawner.spawnEnvironment(manifest);
        this.liquidMesh = newMesh;
        log(`System synchronized successfully via Binary Split Consensus.`, 'text-emerald-400');
        return { status: "Synchronized", manifest };
      }
      updateFrame(time) {
        if (!this.liquidMesh) return;
        const audioEnergy = this.conductor ? this.conductor.getAudioEnergy() : 0;
        const tension = this.conductor ? this.conductor.tension : 0;
        const displacementFactor = 0.1 + (tension * 0.1) + (audioEnergy * 0.5);

        const posAttr = this.liquidMesh.geometry.attributes.position;
        const vertex = new THREE.Vector3();
        for (let i = 0; i < posAttr.count; i++) {
          vertex.fromBufferAttribute(posAttr, i);
          let normal = vertex.clone().normalize();
          let distance = 1.4 + Math.sin(vertex.x * 6 + time * (4 + audioEnergy * 8)) * 
                         Math.cos(vertex.y * 6 + time * (4 + audioEnergy * 8)) * displacementFactor;
          vertex.copy(normal).multiplyScalar(distance);
          posAttr.setXYZ(i, vertex.x, vertex.y, vertex.z);
        }
        posAttr.needsUpdate = true;
        this.liquidMesh.geometry.computeVertexNormals();
      }
    }

    // --- 7. THREE.JS & SYSTEM INITIALIZATION ---
    let scene, camera, renderer, liquidMesh, particleSystem;
    let mouseX = 0, mouseY = 0, targetX = 0, targetY = 0;
    let conductor, spawner, swarm, epochSandbox;

    function initMatrixSystem() {
      const container = document.getElementById('webgl-bg');
      scene = new THREE.Scene();
      camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.z = 5;

      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      scene.add(new THREE.AmbientLight(0xffffff, 0.8));
      const pointLight = new THREE.PointLight(0x00a2ff, 3, 50);
      pointLight.position.set(2, 3, 4);
      scene.add(pointLight);

      const geometry = new THREE.IcosahedronGeometry(1.4, 64);
      const material = new THREE.MeshStandardMaterial({ color: 0x00a2ff, roughness: 0.15, metalness: 0.85, emissive: 0x003366, emissiveIntensity: 0.4 });
      liquidMesh = new THREE.Mesh(geometry, material);
      scene.add(liquidMesh);

      const particleGeo = new THREE.BufferGeometry();
      const count = 1200;
      const positions = new Float32Array(count * 3);
      for (let i = 0; i < count * 3; i += 3) {
        positions[i] = (Math.random() - 0.5) * 20;
        positions[i+1] = (Math.random() - 0.5) * 12;
        positions[i+2] = (Math.random() - 0.5) * 10;
      }
      particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      particleSystem = new THREE.Points(particleGeo, new THREE.PointsMaterial({ color: 0x38bdf8, size: 0.04, transparent: true, opacity: 0.7 }));
      scene.add(particleSystem);

      // Initialize Audio & Binary Split Swarm Architecture
      const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      conductor = new OrchestralConductor(audioCtx);
      spawner = new OntologicalWorldSpawner(scene);
      swarm = new InternalMirrorSwarm(conductor, spawner, liquidMesh);
      epochSandbox = new EpochPhysicsSandbox(scene, conductor);

      orionAudioWorker.onmessage = (e) => {
        if (e.data.type === 'TICK') {
          if (conductor.isPlaying) conductor.onWorkerTick(e.data.step);
          if (e.data.step % 2 === 0 && epochSandbox) epochSandbox.spawnBeatPulse();
        }
      };

      window.addEventListener('mousemove', (e) => {
        mouseX = (e.clientX / window.innerWidth) * 2 - 1;
        mouseY = -(e.clientY / window.innerHeight) * 2 + 1;
      });

      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });

      initSpectrumVisualizer();
      animateMatrixLoop();
    }

    function animateMatrixLoop() {
      requestAnimationFrame(animateMatrixLoop);
      const time = Date.now() * 0.002;

      targetX += (mouseX - targetX) * 0.05;
      targetY += (mouseY - targetY) * 0.05;

      liquidMesh.rotation.y = time * 0.3 + targetX * 1.5;
      liquidMesh.rotation.x = time * 0.2 + targetY * 1.5;

      if (swarm) swarm.updateFrame(time);
      if (epochSandbox && liquidMesh) epochSandbox.updateFrame(time, liquidMesh);
      if (particleSystem) particleSystem.rotation.y -= 0.0008;

      renderer.render(scene, camera);
    }

    // --- 8. SPECTRUM VISUALIZER RENDERING ---
    function initSpectrumVisualizer() {
      const canvas = document.getElementById('spectrum-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      function renderSpectrum() {
        requestAnimationFrame(renderSpectrum);
        ctx.fillStyle = 'rgba(2, 6, 23, 0.4)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        if (!conductor || !conductor.analyser || !conductor.isPlaying) return;

        const bufferLength = conductor.analyser.frequencyBinCount;
        const dataArray = new Uint8Array(bufferLength);
        conductor.analyser.getByteFrequencyData(dataArray);

        const barWidth = (canvas.width / bufferLength) * 1.8;
        let x = 2;
        for (let i = 0; i < bufferLength; i++) {
          const barHeight = (dataArray[i] / 255.0) * canvas.height;
          const gradient = ctx.createLinearGradient(0, canvas.height, 0, 0);
          gradient.addColorStop(0, '#00a2ff');
          gradient.addColorStop(1, '#f43f5e');
          ctx.fillStyle = gradient;
          ctx.fillRect(x, canvas.height - barHeight, barWidth, barHeight);
          x += barWidth + 2;
        }
      }
      renderSpectrum();
    }

    // --- 9. UI EVENT HANDLERS & HELPERS ---
    function handleSwarmPrompt(e) {
      e.preventDefault();
      const input = document.getElementById('swarm-input');
      const val = input.value.trim();
      if (!val) return;
      if (swarm) swarm.processUserInquiry(val);
      input.value = '';
    }

    function updateDJFilter(val) {
      const freq = parseFloat(val);
      if (conductor) conductor.setFilterCutoff(freq);
      document.getElementById('filter-val').textContent = freq >= 1000 ? `${(freq/1000).toFixed(1)} kHz` : `${Math.round(freq)} Hz`;
    }

    function updateDJDrive(val) {
      const pct = parseFloat(val);
      if (conductor) conductor.setDriveAmount(pct * 2);
      document.getElementById('drive-val').textContent = `${Math.round(pct)}%`;
    }

    function selectChordNode(idx, name, freqs) {
      if (!conductor) return;
      if (!conductor.isPlaying) conductor.start(4);
      conductor.forceChord(idx, name, freqs);
      document.getElementById('hud-chord').textContent = name;
    }

    let sandboxActive = false;
    function toggleEpochSandbox() {
      sandboxActive = !sandboxActive;
      const btn = document.getElementById('sandbox-toggle-btn');
      if (sandboxActive) {
        if (epochSandbox) epochSandbox.start();
        if (conductor && !conductor.isPlaying) conductor.start(4);
        btn.textContent = "Stop Arcade Physics";
        btn.className = "w-full py-1.5 bg-rose-600 hover:bg-rose-500 text-white font-bold rounded-lg text-[10px] transition cursor-pointer shadow";
      } else {
        if (epochSandbox) epochSandbox.stop();
        btn.textContent = "🕹️ Launch Arcade Physics Sandbox";
        btn.className = "w-full py-1.5 bg-amber-600 hover:bg-amber-500 text-white font-bold rounded-lg text-[10px] transition cursor-pointer shadow";
      }
    }

    function saveCurrentSession() {
      const input = document.getElementById('vault-name-input');
      const name = input.value.trim() || `Session_${new Date().toLocaleTimeString()}`;
      const sessions = JSON.parse(localStorage.getItem('orion_vault') || '{}');
      sessions[name] = { name, tempo: conductor ? conductor.tempo : 120, time: new Date().toISOString() };
      localStorage.setItem('orion_vault', JSON.stringify(sessions));
      alert(`Session "${name}" saved to local vault.`);
      input.value = '';
    }

    window.addEventListener('keydown', (e) => {
      if (!conductor || !conductor.isPlaying) return;
      if (e.key === 'w' || e.key === 'W') { conductor.setTempo(conductor.tempo + 5); }
      else if (e.key === 's' || e.key === 'S') { conductor.setTempo(conductor.tempo - 5); }
      else if (e.key === 'e' || e.key === 'E') { conductor.transpose(conductor.transpositionSemitones + 1); }
      else if (e.key === 'q' || e.key === 'Q') { conductor.transpose(conductor.transpositionSemitones - 1); }

      document.getElementById('hud-tempo').textContent = `${conductor.tempo} BPM`;
    });

    setInterval(() => {
      document.getElementById('live-clock').textContent = new Date().toTimeString().split(' ')[0].substring(0, 5);
    }, 1000);

    // Boot Matrix System on Load
    window.addEventListener('load', initMatrixSystem);
  </script>
