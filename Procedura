        const os = new WindowManager();

        // App 1: AI Model Forge Logic
        const forgeApp = {
            runInference: () => {
                const consoleEl = document.getElementById('forge-console');
                const prompt = document.getElementById('forge-prompt').value || 'Hello AIM OS';
                consoleEl.innerHTML += `<div>> Prompt: "${prompt}"</div>`;
                consoleEl.innerHTML += `<div>[Inference]: Tokenizing input... generating response...</div>`;
                setTimeout(() => {
                    consoleEl.innerHTML += `<div class="text-indigo-300">> Output: Synthesized response complete. Loss: 0.0142. Confidence: 98.4%.</div>`;
                    consoleEl.scrollTop = consoleEl.scrollHeight;
                }, 600);
            }
        };

        // App 2: Sprite & Skin Generator Logic
        const spriteApp = {
            color: '#ec4899',
            init: () => {
                const canvas = document.getElementById('sprite-canvas');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                const size = 16;
                const pixelSize = canvas.width / size;
                let grid = Array(size).fill(0).map(() => Array(size).fill('#0b0f19'));

                const draw = () => {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    for (let y = 0; y < size; y++) {
                        for (let x = 0; x < size; x++) {
                            ctx.fillStyle = grid[y][x];
                            ctx.fillRect(x * pixelSize, y * pixelSize, pixelSize, pixelSize);
                            ctx.strokeStyle = 'rgba(255,255,255,0.03)';
                            ctx.strokeRect(x * pixelSize, y * pixelSize, pixelSize, pixelSize);
                        }
                    }
                };

                let isDrawing = false;
                canvas.onmousedown = (e) => { isDrawing = true; paint(e); };
                canvas.onmousemove = (e) => { if (isDrawing) paint(e); };
                window.onmouseup = () => { isDrawing = false; };

                const paint = (e) => {
                    const rect = canvas.getBoundingClientRect();
                    const x = Math.floor((e.clientX - rect.left) / (rect.width / size));
                    const y = Math.floor((e.clientY - rect.top) / (rect.height / size));
                    if (x >= 0 && x < size && y >= 0 && y < size) {
                        grid[y][x] = spriteApp.color;
                        draw();
                    }
                };

                draw();
                window.spriteGrid = grid;
                window.drawSprite = draw;
            },
            setColor: (c) => { spriteApp.color = c; },
            clearCanvas: () => {
                if (window.spriteGrid) {
                    window.spriteGrid = window.spriteGrid.map(row => row.fill('#0b0f19'));
                    window.drawSprite();
                }
            },
            randomize: () => {
                if (window.spriteGrid) {
                    const colors = ['#ec4899', '#8b5cf6', '#06b6d4', '#10b981', '#f59e0b'];
                    window.spriteGrid = window.spriteGrid.map(row => row.map(() => Math.random() > 0.6 ? colors[Math.floor(Math.random() * colors.length)] : '#0b0f19'));
                    window.drawSprite();
                }
            }
        };

        // App 3: Tactical Skirmish Engine Logic
        const tacticalApp = {
            init: () => {
                const canvas = document.getElementById('tactical-canvas');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                const cols = 10, rows = 8;
                const cw = canvas.width / cols;
                const ch = canvas.height / rows;

                let units = [
                    { x: 2, y: 3, type: 'player', name: 'Knight', hp: 100 },
                    { x: 2, y: 4, type: 'player', name: 'Archer', hp: 80 },
                    { x: 7, y: 3, type: 'enemy', name: 'Ork', hp: 90 },
                    { x: 8, y: 4, type: 'enemy', name: 'Goblin', hp: 60 }
                ];

                let selected = null;

                const draw = () => {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    // Grid lines
                    for (let r = 0; r < rows; r++) {
                        for (let c = 0; c < cols; c++) {
                            ctx.strokeStyle = 'rgba(255,255,255,0.06)';
                            ctx.strokeRect(c * cw, r * ch, cw, ch);
                        }
                    }

                    // Draw Units
                    units.forEach(u => {
                        ctx.fillStyle = u.type === 'player' ? '#06b6d4' : '#f43f5e';
                        ctx.beginPath();
                        ctx.arc(u.x * cw + cw/2, u.y * ch + ch/2, cw/3, 0, Math.PI * 2);
                        ctx.fill();
                        ctx.fillStyle = '#fff';
                        ctx.font = '10px sans-serif';
                        ctx.fillText(u.name[0], u.x * cw + cw/2 - 3, u.y * ch + ch/2 + 3);
                    });
                };

                canvas.onclick = (e) => {
                    const rect = canvas.getBoundingClientRect();
                    const x = Math.floor((e.clientX - rect.left) / cw);
                    const y = Math.floor((e.clientY - rect.top) / ch);

                    const clickedUnit = units.find(u => u.x === x && u.y === y);
                    if (clickedUnit) {
                        selected = clickedUnit;
                    } else if (selected) {
                        selected.x = x;
                        selected.y = y;
                        selected = null;
                    }
                    draw();
                };

                draw();
                window.tacticalState = { units, draw };
            },
            nextTurn: () => {
                const turnEl = document.getElementById('tac-turn');
                if (turnEl) turnEl.innerText = parseInt(turnEl.innerText) + 1;
            },
            spawnWave: () => {
                if (window.tacticalState) {
                    window.tacticalState.units.push({ x: 9, y: Math.floor(Math.random() * 8), type: 'enemy', name: 'Drone', hp: 50 });
                    document.getElementById('tac-enemy').innerText = parseInt(document.getElementById('tac-enemy').innerText) + 1;
                    window.tacticalState.draw();
                }
            }
        };

        // App 4: Audio DSP Synthesizer Logic
        const synthApp = {
            freq: 440,
            wave: 'sine',
            setFreq: (f) => {
                synthApp.freq = f;
                document.getElementById('synth-freq-lbl').innerText = `${f} Hz`;
            },
            setWave: (w) => { synthApp.wave = w; },
            playTone: () => { synthApp.playNote(synthApp.freq); },
            playNote: (f) => {
                try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = synthApp.wave;
                    osc.frequency.setValueAtTime(f, ctx.currentTime);
                    gain.gain.setValueAtTime(0.15, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.6);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.6);
                } catch (e) {
                    console.error(e);
                }
            }
        };

        // App 5: Local AI Copilot Chat Logic
        const copilotApp = {
            sendMessage: () => {
                const input = document.getElementById('chat-input');
                const text = input.value.trim();
                if (!text) return;
                const container = document.getElementById('chat-messages');

