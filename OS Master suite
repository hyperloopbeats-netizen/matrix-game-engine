    <!-- JavaScript Application Logic -->
    <script>
        // Initialize Lucide Icons
        lucide.createIcons();

        // Clock Update
        function updateClock() {
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            document.getElementById('clock').textContent = `${hours}:${minutes}`;
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Window Management
        let activeZIndex = 30;
        function bringToFront(winId) {
            const win = document.getElementById(winId);
            win.style.zIndex = ++activeZIndex;
        }

        function openWindow(name) {
            const win = document.getElementById(`win-${name}`);
            win.classList.remove('hidden', 'minimized');
            bringToFront(`win-${name}`);
            document.getElementById('active-app-title').textContent = win.querySelector('span.font-medium').textContent;
        }

        function closeWindow(name) {
            document.getElementById(`win-${name}`).classList.add('hidden');
        }

        function minimizeWindow(name) {
            document.getElementById(`win-${name}`).classList.add('minimized');
        }

        function toggleWindow(name) {
            const win = document.getElementById(`win-${name}`);
            if (win.classList.contains('hidden') || win.classList.contains('minimized')) {
                openWindow(name);
            } else {
                minimizeWindow(name);
            }
        }

        // Draggable Windows
        let draggingWindow = null;
        let offsetX = 0, offsetY = 0;

        function startDrag(e, winId) {
            draggingWindow = document.getElementById(winId);
            bringToFront(winId);
            const rect = draggingWindow.getBoundingClientRect();
            offsetX = e.clientX - rect.left;
            offsetY = e.clientY - rect.top;
            document.addEventListener('mousemove', onDrag);
            document.addEventListener('mouseup', stopDrag);
        }

        function onDrag(e) {
            if (!draggingWindow) return;
            draggingWindow.style.left = (e.clientX - offsetX) + 'px';
            draggingWindow.style.top = (e.clientY - offsetY) + 'px';
        }

        function stopDrag() {
            draggingWindow = null;
            document.removeEventListener('mousemove', onDrag);
            document.removeEventListener('mouseup', stopDrag);
        }

        // Three.js 3D Skin Mesh Preview Setup
        let scene, camera, renderer, mesh;
        function initThree() {
            const container = document.getElementById('three-container');
            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            container.appendChild(renderer.domElement);

            const geometry = new THREE.TorusKnotGeometry(1, 0.35, 128, 32);
            const material = new THREE.MeshStandardMaterial({ 
                color: 0x06b6d4, 
                roughness: 0.2, 
                metalness: 0.8,
                wireframe: false
            });
            mesh = new THREE.Mesh(geometry, material);
            scene.add(mesh);

            const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
            scene.add(ambientLight);
            const pointLight = new THREE.PointLight(0x8b5cf6, 2, 50);
            pointLight.position.set(5, 5, 5);
            scene.add(pointLight);

            camera.position.z = 4;

            container.addEventListener('click', () => {
                // Stress test flash animation
                material.color.setHex(Math.random() * 0xffffff);
                mesh.scale.set(1.15, 1.15, 1.15);
                setTimeout(() => mesh.scale.set(1, 1, 1), 150);
            });

            animateThree();
        }

        function animateThree() {
            requestAnimationFrame(animateThree);
            mesh.rotation.x += 0.005;
            mesh.rotation.y += 0.008;
            renderer.render(scene, camera);
        }

        function triggerSynthesis() {
            if(mesh) {
                mesh.material.color.setHex(0x9333ea);
                document.getElementById('vert-count').textContent = "Vertices: " + Math.floor(4000 + Math.random() * 1000);
            }
        }

        window.addEventListener('load', () => {
            initThree();
            initSkirmishGrid();
        });

        // Tactical Skirmish Grid (A* Simulation)
        function initSkirmishGrid() {
            const grid = document.getElementById('skirmish-grid');
            grid.innerHTML = '';
            for (let i = 0; i < 64; i++) {
                const cell = document.createElement('div');
                cell.className = 'bg-slate-900/60 rounded border border-white/5 flex items-center justify-center text-[10px] font-mono text-slate-600 cursor-pointer hover:bg-emerald-500/20 transition';
                if (i === 0) {
                    cell.innerHTML = '<span class="text-emerald-400 font-bold">P1</span>';
                    cell.className += ' border-emerald-500/40 bg-emerald-500/10';
                } else if (i === 63) {
                    cell.innerHTML = '<span class="text-rose-400 font-bold">AI</span>';
                    cell.className += ' border-rose-500/40 bg-rose-500/10';
                } else if (i === 27 || i === 28 || i === 35) {
                    cell.className += ' bg-slate-800/80 border-slate-700';
                    cell.innerHTML = '<span class="text-slate-500">#</span>';
                } else {
                    cell.textContent = i;
                }
                grid.appendChild(cell);
            }
        }

        function runSkirmishTurn() {
            const log = document.getElementById('skirmish-log');
            const timeStr = new Date().toTimeString().split(' ')[0];
            log.innerHTML += `<br>[${timeStr}] A* Director: Unit repositioned along optimal heuristic vector.`;
            log.scrollTop = log.scrollHeight;
        }

        // Web Audio DSP Synthesizer
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playSynthNote(freq) {
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            const filter = audioCtx.createBiquadFilter();

            const waveType = document.getElementById('synth-waveform').value;
            const cutoff = parseFloat(document.getElementById('synth-cutoff').value);

            osc.type = waveType;
            osc.frequency.setValueAtTime(freq, audioCtx.currentTime);

            filter.type = 'lowpass';
            filter.frequency.setValueAtTime(cutoff, audioCtx.currentTime);

            gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.8);

            osc.connect(filter);
            filter.connect(gain);
            gain.connect(audioCtx.destination);

            osc.start();
            osc.stop(audioCtx.currentTime + 0.8);
        }

        document.getElementById('synth-cutoff').addEventListener('input', (e) => {
            document.getElementById('cutoff-val').textContent = e.target.value + 'Hz';
        });
        document.getElementById('synth-reverb').addEventListener('input', (e) => {
            document.getElementById('reverb-val').textContent = Math.round(e.target.value * 100) + '%';
        });

        // AI Copilot Chat
        function sendCopilotPrompt() {
            const input = document.getElementById('copilot-input');
            const chat = document.getElementById('copilot-chat');
            const val = input.value.trim();
            if (!val) return;

            chat.innerHTML += `<div class="text-slate-200">&gt; ${val}</div>`;
            input.value = '';

            setTimeout(() => {
                chat.innerHTML += `<div class="text-cyan-400">[AIM OS Copilot]: Executed query successfully. All sub-systems operating within nominal parameters.</div>`;
                chat.scrollTop = chat.scrollHeight;
            }, 400);
            chat.scrollTop = chat.scrollHeight;
        }
    </script>
</body>
